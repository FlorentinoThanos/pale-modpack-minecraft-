	quest.3B7110855E76678A.title: "Millstone"
	quest.3C7B37315B41515F.quest_desc: ["Brew a potion of rampage."]
	quest.3C7B37315B41515F.title: "Rampage"
	quest.3D753A32456BDA7A.quest_desc: ["Ore cracks into Create's crushed ore."]
	quest.3D753A32456BDA7A.title: "Smashing"
	quest.3DB556DE613B82CC.quest_desc: ["Build a portal and step into the Nether. Pale Store unlocks the diamond pickaxe recipe right away."]
	quest.3DB556DE613B82CC.title: "Deeper Down"
	quest.3DF6E6E5D0A4B668.quest_desc: ["Double your ore."]
	quest.3DF6E6E5D0A4B668.title: "Pulverizer and Furnace"
	quest.3EA38D8286E0AE6D.quest_desc: ["Warmth you can carry around."]
	quest.3EA38D8286E0AE6D.title: "Soulspring Lamp"
	quest.3F2B1450BCEDB172.quest_desc: ["Dark towers stand only in the north."]
	quest.3F2B1450BCEDB172.title: "Dark Tower"
	quest.3FC09F55AE6D1C15.quest_desc: ["Find a woodland mansion. Illagers live inside, so come prepared."]
