{
	chapter.07E315186D30B614.chapter_subtitle: ["Everything worth killing: first the common monsters of the mild island, then the spawn of chaos in the south and north."]
	chapter.07E315186D30B614.title: "Death List"
	chapter.22F1E7462ABF2081.chapter_subtitle: ["The most dangerous island. Only on wings, and only for those who are ready."]
	chapter.22F1E7462ABF2081.title: "The Cold Island"
	chapter.24C62B88537DAC31.chapter_subtitle: ["Fire, fortresses and the short way south: one block here is eight up top."]
	chapter.24C62B88537DAC31.title: "The Nether"
	chapter.2920D939556DC7BD.chapter_subtitle: ["Farmer's Delight: hot soup keeps you warm in the north, ice cream keeps you cool in the south."]
	chapter.2920D939556DC7BD.title: "The Kitchen"
	chapter.2ED18204A08D5527.chapter_subtitle: ["Under the sand and soil lie the remains of those who lived here before the Pale."]
	chapter.2ED18204A08D5527.title: "Archeology"
	chapter.2F261106BE3CE85D.chapter_subtitle: ["An allay can become an amulet or an angel, and chests hide relics. You will want all of it for the finale."]
	chapter.2F261106BE3CE85D.title: "Angels and Relics"
	chapter.30AC85DB139601AB.chapter_subtitle: ["What else the mild island holds: villages, a mansion, raids, trials and an ancient city."]
	chapter.30AC85DB139601AB.title: "Exploring the Island"
	chapter.3474A9E97CA5B570.chapter_subtitle: ["How the pack works: death, combat, food, temperature, moons and teams. Everything here is just ticked off."]
	chapter.3474A9E97CA5B570.title: "Handbook"
	chapter.38EE5D196554F12F.chapter_subtitle: ["The dragon guards the wings you need to reach the north."]
	chapter.38EE5D196554F12F.title: "The End"
	chapter.3C1E489A1ED8C2DB.chapter_subtitle: ["Create Aeronautics airships. Above the Pale the air thins: by height 300 no balloon or propeller can climb."]
	chapter.3C1E489A1ED8C2DB.title: "The Sky"
	chapter.3CB18D585B48DDF5.chapter_subtitle: ["A train through the Nether from the mild island's portal to the hot island's. No track carries people across the Pale."]
	chapter.3CB18D585B48DDF5.title: "The Southern Mainline"
	chapter.3EFF447036D93718.chapter_subtitle: ["Deserts to the east, jungle to the west. And the first spawn of chaos."]
	chapter.3EFF447036D93718.title: "The Hot Island"
	chapter.46121B1B8CF045BA.chapter_subtitle: ["Oil exists only on the hot island: in deserts, badlands and savannas. Power starts here."]
	chapter.46121B1B8CF045BA.title: "Oil and Power"
	chapter.4BF4D6F999A3ED91.chapter_subtitle: ["Oritech's machines are built from nickel and platinum, and those exist only on the cold island."]
	chapter.4BF4D6F999A3ED91.title: "Oritech"
	chapter.52326DE657CCE52E.chapter_subtitle: ["The main path: from your first crafting table to the crossing to the hot island."]
	chapter.52326DE657CCE52E.title: "The Mild Island"
	chapter.7B6726D6472E01D6.chapter_subtitle: ["What lives in the fog can be called. It will not go back."]
	chapter.7B6726D6472E01D6.title: "The Pale"
	chapter.7E8FCA9C94726E5A.chapter_subtitle: ["Create: from a water wheel to a mechanical arm. Everything that turns."]
	chapter.7E8FCA9C94726E5A.title: "Machinery"
	chapter_group.307C6B906CED1091.title: "Side Chapters"
	chapter_group.6FA7D509EB9A847A.title: "Story"
	quest.008FF5143747F539.quest_desc: ["Flies on power or fuel."]
	quest.008FF5143747F539.title: "Jetpack"
	quest.00969B7E7A07CF4F.quest_desc: ["Stronger when built from several."]
	quest.00969B7E7A07CF4F.title: "Large Diesel Engine"
	quest.01719B67D1524ABF.quest_desc: ["Faster and sturdier than the plain one."]
	quest.01719B67D1524ABF.title: "Iron Brush"
	quest.01A5D7C74EF1C2E4.quest_desc: ["Careful, you'll want it for a reactor."]
	quest.01A5D7C74EF1C2E4.title: "Uranium"
	quest.0315F2415B866728.title: "Firelight"
	quest.03294AA7A21B24F9.quest_desc: ["Krampus' horn and permafrost make a horn of snowstorms."]
	quest.03294AA7A21B24F9.title: "Stormcaller's Horn"
	quest.033DAECDB8EDA485.quest_desc: ["An angel rests and recharges on an active beacon: use the Angel Vessel on it. Amulets and angels are blessed there too."]
	quest.033DAECDB8EDA485.title: "Beacon Light"
	quest.0388B9AB157B8169.quest_desc: ["There is no way back. Tick the quest and claim the reward: it starts the invasion. In three game days the thing from the fog comes ashore at night on the island with the most players. The sky darkens on the first day, and on the second its silhouette stands on the horizon. Bring netherite armour, potions and food for the whole team."]
	quest.0388B9AB157B8169.title: "Summon the Pale"
	quest.03C119B689CF5F32.quest_desc: ["Gather dark metal ingots and forge a chestplate. A dark metal set beats netherite; it is what you take north."]
	quest.03C119B689CF5F32.title: "Dark Metal"
	quest.03FA7F1DAE6ECFF3.quest_desc: ["Brew any potion."]
	quest.03FA7F1DAE6ECFF3.title: "Home Brew"
	quest.0410BCFCA686EEC7.quest_desc: ["Fly about 4000 blocks north (negative Z) and land on the snow. The reward is the ancient Soaring Winds book for your elytra."]
	quest.0410BCFCA686EEC7.title: "Northern Shore"
	quest.0410FB32DE32FD1D.quest_desc: ["Kill 10 creepers."]
	quest.0410FB32DE32FD1D.title: "Creepers"
	quest.0448AC785A06ADA3.quest_desc: ["Nether quartz and redstone. Polish it and make an electron tube."]
	quest.0448AC785A06ADA3.title: "Rose Quartz"
	quest.0486650A8916E524.quest_desc: ["A mechanical press turns ingots into sheets."]
	quest.0486650A8916E524.title: "Press"
	quest.04DD2D2E5D5FC5CF.quest_desc: ["Bring a totem of undying once you have beaten a Fallen Chaos Knight. The reward is a Soulbound book: the item stays with you when you die."]
	quest.04DD2D2E5D5FC5CF.title: "Soulbound"
	quest.0580B33A9D0FFD4D.quest_desc: ["Found while digging. Shards make up an artifact."]
	quest.0580B33A9D0FFD4D.title: "Artifact Shards"
	quest.06303D3A946FF551.quest_desc: ["Turns and picks up Create's parts."]
	quest.06303D3A946FF551.title: "Wrench"
	quest.0646515EE987BBFA.quest_desc: ["An evoker from the mansion drops it. It saves you from death once."]
	quest.0646515EE987BBFA.title: "Totem of Undying"
	quest.0646530161F06C69.quest_desc: ["Ride the rails through the Nether to the southern portal (around x 0, z 500). In the Overworld no track crosses the Pale for you: the fog is poison, and no passenger survives the trip. Cargo with nobody aboard does."]
	quest.0646530161F06C69.title: "The Southern Mainline"
	quest.06E84370328D5709.quest_desc: ["Cook and eat every dish on Farmer's Delight's advancement list."]
	quest.06E84370328D5709.title: "Master Chef"
	quest.06F27455A8C1762B.quest_desc: ["Make a bucket. The reward is a random Insight book, I to III."]
	quest.06F27455A8C1762B.title: "Bucket"
	quest.071CA0CD6B15C063.quest_desc: ["Better Combat changes how fights feel: weapons hit in combos, each with its own reach and swing, and a blow hits everything in its arc. Two-handed weapons can't be held with a shield."]
	quest.071CA0CD6B15C063.title: "New Combat"
	quest.0749A1C45B0EA552.quest_desc: ["And back: rotation into electricity. The accumulator stores it."]
	quest.0749A1C45B0EA552.title: "Alternator and Accumulator"
	quest.0769CB83115313F0.quest_desc: ["Obsidian to powder, powder to a sheet. Trains need it."]
	quest.0769CB83115313F0.title: "Sturdy Sheet"
	quest.076EADF2C150DE8E.quest_desc: ["Train casing is made from sturdy sheets."]
	quest.076EADF2C150DE8E.title: "Train Casing"
	quest.07F4FAD00FE4552B.quest_desc: ["This elixir wakes Lord Pumpkinhead. It only works in the north."]
	quest.07F4FAD00FE4552B.title: "Transmuting Elixir"
	quest.084AB390024C4487.quest_desc: ["Fill a bucket with crude oil."]
	quest.084AB390024C4487.title: "Crude Oil"
	quest.08A8A131FFBDFBE1.quest_desc: ["A belt made of dried kelp carries items."]
	quest.08A8A131FFBDFBE1.title: "Belt"
	quest.08EFDAF4AFF27FBA.quest_desc: ["The headless rider, the Lord's younger brother."]
	quest.08EFDAF4AFF27FBA.title: "Sir Pumpkinhead"
	quest.09DFA446653ADFDB.quest_desc: ["You can see half the island from it."]
	quest.09DFA446653ADFDB.title: "Observation Tower"
	quest.09F337429BFEAAC2.quest_desc: ["New Age's magnets need magnetite."]
	quest.09F337429BFEAAC2.title: "Magnetite"
	quest.0AFB75AAD7CA50EE.quest_desc: ["Separates materials."]
	quest.0AFB75AAD7CA50EE.title: "Centrifuge"
	quest.0B0F1DC398076B5B.quest_desc: ["Create New Age's thorium ore exists only on the cold island."]
	quest.0B0F1DC398076B5B.title: "Thorium"
	quest.0BC8FFA36F43ED32.quest_desc: ["The netherite upgrade template is in bastion chests."]
	quest.0BC8FFA36F43ED32.title: "Upgrade Template"
	quest.0C29D21D55168A37.quest_desc: ["Insulate a full set of armour at the sewing table."]
	quest.0C29D21D55168A37.title: "Fully Insulated"
	quest.0C4B684807213C25.quest_desc: ["Distant Horizons draws terrain far past the render distance: from the shore you see the fog wall, and from above the other islands. Iris shaders are on by default; if the game is slow, turn them off in the video settings."]
	quest.0C4B684807213C25.title: "Far View"
	quest.0C9D2F40DB85901F.quest_desc: ["His hammer stuns."]
	quest.0C9D2F40DB85901F.title: "Skeleton Thrasher"
	quest.0CDA0A41D70C98EC.quest_desc: ["You know how to enchant. Now the list: kill those written in it and take the rewards. The first lines can be crossed off on the mild island."]
	quest.0CDA0A41D70C98EC.title: "Death List"
	quest.0D317297C92105F5.quest_desc: ["Enchant items on the table 30 times. Next comes the Death List chapter."]
	quest.0D317297C92105F5.title: "Enchanter"
	quest.0D35E616BE5B4892.quest_desc: ["The zombie clowns' caravan in the savanna."]
	quest.0D35E616BE5B4892.title: "Clown Caravan"
	quest.0D395F6CC34368F9.quest_desc: ["Faster and stronger."]
	quest.0D395F6CC34368F9.title: "Advanced Motor"
	quest.0D58FFF06C46B766.quest_desc: ["Stylish."]
	quest.0D58FFF06C46B766.title: "Aviator's Goggles"
	quest.0D95AD042A8F6753.quest_desc: ["Dangerous, but full of gold, templates and debris."]
	quest.0D95AD042A8F6753.title: "Bastion"
	quest.0DB0D487322A1055.quest_desc: ["Find a jungle temple."]
	quest.0DB0D487322A1055.title: "Jungle Temple"
	quest.0E0D5DC6409042D9.quest_desc: ["Oil barrels hold plenty and ride on trains and ships."]
	quest.0E0D5DC6409042D9.title: "Oil Barrels"
	quest.0E586753D20A5A43.quest_desc: ["Armour from crab shells."]
	quest.0E586753D20A5A43.title: "Spiny Shell Armour"
	quest.0EA0FC2580A8E65D.quest_desc: ["Find a woodland mansion. Illagers live inside, so come prepared. Allays sit in its cages."]
	quest.0EA0FC2580A8E65D.title: "Woodland Mansion"
	quest.0EAC18A57865D6D9.quest_desc: ["Defeat Krampus."]
	quest.0EAC18A57865D6D9.title: "Krampus"
	quest.0F55A4D4E51A5010.quest_desc: ["Find every fossil."]
	quest.0F55A4D4E51A5010.title: "Palaeontologist"
	quest.0F69B198F20785A0.quest_desc: ["You need it to make brass. The reward is a Smelting book: mined ore drops as ingots."]
	quest.0F69B198F20785A0.title: "Blaze Burner"
	quest.101F5B869F1FB6B7.quest_desc: ["Defeat the Dire Hound Leader."]
	quest.101F5B869F1FB6B7.title: "Hound Leader"
	quest.10EADDECB31F69A8.quest_desc: ["Chorus fruit from the outer islands."]
	quest.10EADDECB31F69A8.title: "Chorus"
	quest.10FD912A25B949A6.quest_desc: ["A charged crystal for late machines."]
	quest.10FD912A25B949A6.title: "Fluxite"
	quest.117325654E654D62.quest_desc: ["Kill 8 blazes and collect 6 blaze rods."]
	quest.117325654E654D62.title: "Blazes"
	quest.11C14F27ECDF1677.quest_desc: ["Display boards and links show what's going on in the factory."]
	quest.11C14F27ECDF1677.title: "Display Board"
	quest.11C63DC459EEA6CF.quest_desc: ["A jetpack with elytra makes flying between islands easier. It's a chestplate; it doesn't go into the wing slot."]
	quest.11C63DC459EEA6CF.title: "Boosted Elytra"
	quest.11E96124CD295ED1.quest_desc: ["The nastiest place in the Nether."]
	quest.11E96124CD295ED1.title: "Basalt Deltas"
	quest.11EE6307F604292F.quest_desc: ["Without a diamond pickaxe you can't mine obsidian, so cast the portal in place: build a mould, pour lava into each frame cell and pour water over it. Ruined portals also hold obsidian. Enter the Nether to unlock the diamond pickaxe recipe and the Nether chapter."]
	quest.11EE6307F604292F.title: "Into the Nether"
	quest.123F1F8AE46AA164.quest_desc: ["Alloys two metals into one: electrum, steel, adamant."]
	quest.123F1F8AE46AA164.title: "Foundry"
	quest.12B0A497F3B3C723.quest_desc: ["Keeps a ship on course."]
	quest.12B0A497F3B3C723.title: "Navigation Table"
	quest.12DFBF3A38E8F8C8.quest_desc: ["Spirits take the most from a Spirit Divider."]
	quest.12DFBF3A38E8F8C8.title: "Restless Spirits"
	quest.12FA3EC976BE3DD8.quest_desc: ["Vegetable soup. Warm food in this pack warms your body for a minute (Cold Sweat)."]
	quest.12FA3EC976BE3DD8.title: "Hot Soup"
	quest.131B785C57D41901.quest_desc: ["Find an igloo."]
	quest.131B785C57D41901.title: "Igloo"
	quest.1328AAFF05BF887F.quest_desc: ["Bamboo grows in the jungle."]
	quest.1328AAFF05BF887F.title: "Bamboo"
	quest.13E390A05AEAE91D.quest_desc: ["Doubles your ore."]
	quest.13E390A05AEAE91D.title: "Pulverizer"
	quest.142A7D5B0E76BB45.quest_desc: ["Breed any two animals."]
	quest.142A7D5B0E76BB45.title: "New Arrivals"
	quest.14642FFB536316A1.quest_desc: ["Find a dark forest. That's where mansions stand."]
	quest.14642FFB536316A1.title: "Dark Forest"
	quest.14CF9D977A68CD54.quest_desc: ["Find a village."]
	quest.14CF9D977A68CD54.title: "Neighbours"
	quest.158DB0DBDAB97DEE.quest_desc: ["Insulate any piece of armour on a sewing table."]
	quest.158DB0DBDAB97DEE.title: "Lining Up"
	quest.16B8A826CE2236BB.quest_desc: ["Find a grassy burial mound."]
	quest.16B8A826CE2236BB.title: "Burial Mound"
	quest.17921BECA908D62B.quest_desc: ["Assemble a train: a bogey on the tracks, casing, controls."]
	quest.17921BECA908D62B.title: "Train"
	quest.17F4B4F35FBB8CDD.quest_desc: ["Energy storage you can carry."]
	quest.17F4B4F35FBB8CDD.title: "Battery"
	quest.18BAE9E1D07C3F7C.quest_desc: ["Make a stone pickaxe. The reward unlocks the bed recipe, which is locked until then."]
	quest.18BAE9E1D07C3F7C.title: "Stone Age"
	quest.194D3DA28B456106.quest_desc: ["A potato cannon on deck."]
	quest.194D3DA28B456106.title: "Mounted Cannon"
	quest.19648A5B291B91DD.quest_desc: ["Coils and brushes turn rotation into power."]
	quest.19648A5B291B91DD.title: "New Age Generator"
	quest.199A32EA805BCBC4.quest_desc: ["Tame a chameleon. It finds biomes for you."]
	quest.199A32EA805BCBC4.title: "Pet Chameleon"
	quest.19BFB3CE701A8231.quest_desc: ["A boiler with a smokestack heats a house. Desert nights get cold."]
	quest.19BFB3CE701A8231.title: "Desert Nights"
	quest.19F3064FF15A3876.quest_desc: ["A Terralith hut among the glaciers."]
	quest.19F3064FF15A3876.title: "Glacial Hut"
	quest.1A14DAD479DC44C0.quest_desc: ["Small but annoying."]
	quest.1A14DAD479DC44C0.title: "Flies and Gadflies"
	quest.1A7336D8DA874A8A.quest_desc: ["Create's tracks run through a Nether portal. Take a train through one."]
	quest.1A7336D8DA874A8A.title: "Through the Portal"
	quest.1AA6D5A556DD3D2D.quest_desc: ["Keep your distance: he throws bombs."]
	quest.1AA6D5A556DD3D2D.title: "Skeleton Demoman"
	quest.1ABF12682BDB7BDA.quest_desc: ["Cut tall grass with a knife."]
	quest.1ABF12682BDB7BDA.title: "Straw"
	quest.1ACB00F411AF529B.quest_desc: ["The warm, wet west of the island."]
	quest.1ACB00F411AF529B.title: "Jungle"
	quest.1BE59DC6B19706C5.quest_desc: ["A copper backtank and helmet hold your breath underwater."]
	quest.1BE59DC6B19706C5.title: "Diving Gear"
	quest.1C39D63EA45D9B00.quest_desc: ["Give an allay a nether star: it becomes your angel and strikes your enemies with a holy beam. Each player has only one angel; it lives in the Angel Vessel and tires in battle."]
	quest.1C39D63EA45D9B00.title: "Avenging Angel"
	quest.1C9AC3B7488C41C3.quest_desc: ["Smelts on power, no coal needed."]
	quest.1C9AC3B7488C41C3.title: "Powered Furnace"
	quest.1D4A0C4B85EEE138.quest_desc: ["Organic compost turns dirt into rich soil."]
	quest.1D4A0C4B85EEE138.title: "Compost"
	quest.1D5F79045F5A2E07.quest_desc: ["A hearth warms your whole home."]
	quest.1D5F79045F5A2E07.title: "Hearth"
	quest.1D886E01C48B1318.quest_desc: ["The warmest drink there is. Take some north."]
	quest.1D886E01C48B1318.title: "Hot Cocoa"
	quest.1DAC89F66ADAA9C9.quest_desc: ["Enhanced Celestials changes the nights. Blood moon: twice as many mobs and no sleeping. Harvest moon: crops drop double. Blue moon: double experience, half-price enchanting and anvil, luck for everyone. Super moons are stronger."]
	quest.1DAC89F66ADAA9C9.title: "Moons"
	quest.1EA7A6A20FFADAD8.quest_desc: ["A box you carry around. The flight north gets easier."]
	quest.1EA7A6A20FFADAD8.title: "Shulker Box"
	quest.1EB3664109F92ACB.quest_desc: ["The big solar panel."]
	quest.1EB3664109F92ACB.title: "Big Solar Panel"
	quest.1EC8A39A8FFEF516.quest_desc: ["Faster still."]
	quest.1EC8A39A8FFEF516.title: "Diamond Brush"
	quest.1ED8F23282518DB7.quest_desc: ["Control rods and a fuel acceptor."]
	quest.1ED8F23282518DB7.title: "Rods"
	quest.1FBB5CFB93AA3119.quest_desc: ["Collect it in bottles."]
	quest.1FBB5CFB93AA3119.title: "Dragon's Breath"
	quest.1FF17CAE3B00FA82.quest_desc: ["Move cargo from one island to another by ship or train with nobody aboard: the fog kills people, not chests. Tick the quest off when the cargo arrives."]
	quest.1FF17CAE3B00FA82.title: "Cargo Run"
	quest.205E6085380C2758.quest_desc: ["Relics lie in loot chests all over the world. Each has abilities of its own. Tick this off when you find your first."]
	quest.205E6085380C2758.title: "First Relic"
	quest.20982523A24DD194.quest_desc: ["Builds Oritech's complex parts."]
	quest.20982523A24DD194.title: "Assembler"
	quest.20A1040529E200F6.quest_desc: ["The archeologists' temple in the southern jungle."]
	quest.20A1040529E200F6.title: "Lost Temple"
	quest.20B1FA5A024DD50C.quest_desc: ["Create Crafts & Additions turns electricity into rotation."]
	quest.20B1FA5A024DD50C.title: "Electric Motor"
	quest.20F83F209478D8DF.quest_desc: ["A steam engine on a fluid tank with a burner."]
	quest.20F83F209478D8DF.title: "Steam"
	quest.21864EC69519D30E.quest_desc: ["Builds materials atom by atom. Powered by a laser."]
	quest.21864EC69519D30E.title: "Atomic Forge"
	quest.2243EA074F44A95D.quest_desc: ["A magnetic coil, steel and nickel. Nearly every machine needs motors."]
	quest.2243EA074F44A95D.title: "Motor"
	quest.2250439ED9817711.quest_desc: ["Items drop down a chute."]
	quest.2250439ED9817711.title: "Chute"
	quest.2253A3492757C92D.quest_desc: ["Blowing through water washes, through fire smokes, through lava smelts."]
	quest.2253A3492757C92D.title: "Encased Fan"
	quest.22A6BF64C165711A.quest_desc: ["With Better Combat the weapons of chaos fight their own way: the Dark Warblade is a two-handed claymore, the Great Reaper Axe a two-handed axe, the Skullbreaker a two-handed hammer and the pitchfork a spear. Chaos staffs still work on right-click."]
	quest.22A6BF64C165711A.title: "Weapons of Chaos"
	quest.22F60D1C29A9AEB9.quest_desc: ["Offroad adds wheels. A ship can drive on land as well."]
	quest.22F60D1C29A9AEB9.title: "Rover"
	quest.231B3FF73838F5B4.quest_desc: ["Keeps a ship level."]
	quest.231B3FF73838F5B4.title: "Gyroscopic Propeller"
	quest.238CF919ACEEAA52.quest_desc: ["When it gets too cold around you (at night or high in the mountains), warm up next to a warm block such as a campfire."]
	quest.238CF919ACEEAA52.title: "Huddle Close"
	quest.23E18FD346E5EB6D.quest_desc: ["Cold food cools you down. A lifesaver in the south."]
	quest.23E18FD346E5EB6D.title: "Melon Popsicle"
	quest.23E50727575A4CB3.quest_desc: ["Runs on fuel made from oil. Oritech's oil springs exist only on the hot island."]
	quest.23E50727575A4CB3.title: "Fuel Generator"
	quest.23E7486175360186.quest_desc: ["The invasion has begun. The sky tells you how long is left: the darker, the closer. If everybody dies or leaves, the thing goes back into the sea and returns the next night."]
	quest.23E7486175360186.title: "It Is Coming"
	quest.245821AFD7698303.quest_desc: ["Terralith's dungeon in the ice."]
	quest.245821AFD7698303.title: "Frosted Dungeon"
	quest.24C762C823CD57D6.quest_desc: ["Shoots food. Better than it sounds."]
	quest.24C762C823CD57D6.title: "Potato Cannon"
	quest.24EC6E0898270BEB.quest_desc: ["His knife makes your head spin."]
	quest.24EC6E0898270BEB.title: "Zombie Clown"
	quest.253F64A34921796E.quest_desc: ["A nether star and obsidian."]
	quest.253F64A34921796E.title: "Beacon"
	quest.2560ED259730DE07.quest_desc: ["An overcharged diamond and wire made from it."]
	quest.2560ED259730DE07.title: "Overcharged Diamond"
	quest.25A53111B7CABE72.quest_desc: ["Find a village in the south."]
	quest.25A53111B7CABE72.title: "Desert Village"
	quest.268E03D5637E21BD.quest_desc: ["The plain Nether: netherrack and lava."]
	quest.268E03D5637E21BD.title: "Nether Wastes"
	quest.26B24DBE2B9ECE71.quest_desc: ["Diesel Generators' strongest engine."]
	quest.26B24DBE2B9ECE71.title: "Huge Diesel Engine"
	quest.26B3E224BE0B43A2.quest_desc: ["Cabbages grow by the shore, onions on the plains. Gather both."]
	quest.26B3E224BE0B43A2.title: "Wild Vegetables"
	quest.27B4FD4982C710F5.quest_desc: ["Craft a crafting table."]
	quest.27B4FD4982C710F5.title: "Crafting Table"
	quest.2856DFEB22633543.quest_desc: ["And back: power into rotation."]
	quest.2856DFEB22633543.title: "New Age Motor"
	quest.28D9ED4CB99978FF.quest_desc: ["Lifesteal and wither."]
	quest.28D9ED4CB99978FF.title: "Nightmare Scythe"
	quest.29165060F4EDE7BD.quest_desc: ["Cold Sweat tracks your body temperature. Make a thermometer to see how warm it is around you, and a waterskin: its water cools you in the south, and heated water warms you in the north."]
	quest.29165060F4EDE7BD.title: "Thermometer and Waterskin"
	quest.295417956A1A5F30.quest_desc: ["Distract a piglin with gold."]
	quest.295417956A1A5F30.title: "Oh Shiny"
	quest.2988CB0E98DC3A34.quest_desc: ["Oritech's best metal. A pickaxe and a battleaxe are made of it."]
	quest.2988CB0E98DC3A34.title: "Prometheum"
	quest.29D18589090D5704.quest_desc: ["The story runs through six chapters: the Mild Island, the Nether, the Hot Island, the End, the Cold Island and the Pale. Side chapters (kitchen, machinery, archeology and more) open along the way; they are optional, but they pay rewards and prepare you for the finale."]
	quest.29D18589090D5704.title: "How to Read the Book"
	quest.2A0D353E20B6E2B6.quest_desc: ["A mechanical drill and saw dig and chop on their own."]
	quest.2A0D353E20B6E2B6.title: "Automation"
	quest.2A8D9AB80135141A.quest_desc: ["FTB Teams: quests and unlocked recipes are shared by your team. FTB Chunks: open the map (M) and claim your base's chunks for the team so nobody touches it."]
	quest.2A8D9AB80135141A.title: "Team and Land"
	quest.2B84337841810FE1.quest_desc: ["Put a smokestack on a boiler or an icebox."]
	quest.2B84337841810FE1.title: "Getting Cozy"
	quest.2B9728110E64F29A.quest_desc: ["Someone was buried here long ago."]
	quest.2B9728110E64F29A.title: "Villager Grave"
	quest.2BC86194802C313D.quest_desc: ["Put an artifact together from shards."]
	quest.2BC86194802C313D.title: "Unidentified Artifact"
	quest.2C37D36732A5C6B1.quest_desc: ["There's a way to make it shimmer. Find it yourself."]
	quest.2C37D36732A5C6B1.title: "Pearlescent Levitite"
	quest.2CB7DF60415C15C6.quest_desc: ["Defeat a breeze and take its rod."]
	quest.2CB7DF60415C15C6.title: "Breeze"
	quest.2CF755892C080806.quest_desc: ["Fight off a raid on a village. The reward is the ancient Penetrating Strike book."]
	quest.2CF755892C080806.title: "Raid"
	quest.2D9C6B5CDD4A72BE.quest_desc: ["Summon and defeat the Wither. Far from home."]
	quest.2D9C6B5CDD4A72BE.title: "The Wither"
	quest.2DC5EE261E60B32E.quest_desc: ["Oil, diesel and New Age power: you run your own grid."]
	quest.2DC5EE261E60B32E.title: "Electrifying the South"
	quest.2DD6C16FE2492C84.quest_desc: ["Oritech's reactor controller. Build the walls, rods and cooling around it."]
	quest.2DD6C16FE2492C84.title: "Nuclear Reactor"
	quest.2ED21E7294C3E747.quest_desc: ["They show the speed and stress of your machines."]
	quest.2ED21E7294C3E747.title: "Engineer's Goggles"
	quest.30036867805EA6D5.quest_desc: ["Break a loot vase."]
	quest.30036867805EA6D5.title: "Vase"
	quest.302FAE3B4175F575.quest_desc: ["Twelve eyes of ender. They lead to the stronghold."]
	quest.302FAE3B4175F575.title: "Eye of Ender"
	quest.307AC4D150AA61CC.quest_desc: ["A sacrifice heals you and gives Strength."]
	quest.307AC4D150AA61CC.title: "Ritual Dagger"
	quest.30A62F377F0D8DB9.quest_desc: ["Kill 15 spiders."]
	quest.30A62F377F0D8DB9.title: "Spiders"
	quest.3166092B1DBFD076.quest_desc: ["When you die, your things don't scatter: they stay with your body (the Corpse mod). Go back to it and open it. Don't die in the Pale's fog: the body stays in the poisoned water, and getting it back is close to impossible."]
	quest.3166092B1DBFD076.title: "Last Resting Place"
	quest.316BDBE7B30479D1.quest_desc: ["Hoglins graze in the crimson forest."]
	quest.316BDBE7B30479D1.title: "Hoglin Hide"
	quest.3186683A79A07234.quest_desc: ["Take the egg from the portal."]
	quest.3186683A79A07234.title: "Dragon Egg"
	quest.31AB0EE4C074E86D.quest_desc: ["The south's zombies don't burn in the sun."]
	quest.31AB0EE4C074E86D.title: "Husks"
	quest.31AFBE8CAAB3188F.quest_desc: ["A balloon's envelope is sewn from wool and sticks."]
	quest.31AFBE8CAAB3188F.title: "Envelope"
	quest.320232208FCD1954.quest_desc: ["Wear a relic in a Curios slot and use it: it gathers experience and levels up. Hover it in your inventory and hold the research key (Research Relic Under Cursor in the controls): its screen opens, where abilities are researched and upgraded with points."]
	quest.320232208FCD1954.title: "Levelling Relics"
	quest.32B2FC7FC1FE0154.quest_desc: ["Make a bed of any colour. Now you can sleep through the night."]
	quest.32B2FC7FC1FE0154.title: "A Bed of Your Own"
	quest.33745F47B21001EA.quest_desc: ["Kill 5 endermen."]
	quest.33745F47B21001EA.title: "Endermen"
	quest.33ED485838982C35.quest_desc: ["Iron charged in the energiser."]
	quest.33ED485838982C35.title: "Overcharged Iron"
	quest.34121C8FCBEF4EC1.title: "Scarlet Persecutor"
	quest.347ECC69BCE02B07.quest_desc: ["Make iron leggings and boots."]
	quest.347ECC69BCE02B07.title: "Iron Legs"
	quest.34CD9D9B47FF4557.quest_desc: ["Create's zinc ore lies shallow. Without it there is no brass."]
	quest.34CD9D9B47FF4557.title: "Zinc"
	quest.354E1BDBBDCBF7D3.quest_desc: ["Kill a witch. They live in the swamp."]
	quest.354E1BDBBDCBF7D3.title: "Witch"
	quest.36513951AC94599C.quest_desc: ["Steam 'n' Rails' little handcar, for checking the line."]
	quest.36513951AC94599C.title: "Handcar"
	quest.369E05F385946290.quest_desc: ["A windmill bearing and sails turn without water."]
	quest.369E05F385946290.title: "Windmill"
	quest.3739C0C06C989C7E.quest_desc: ["Make an enchanting table."]
	quest.3739C0C06C989C7E.title: "Enchanting Table"
	quest.37E632692EC464C9.quest_desc: ["A bearing, a crank and a head over the well."]
	quest.37E632692EC464C9.title: "Pumpjack"
	quest.38424CBA31AEF41A.quest_desc: ["Dig up any fossil."]
	quest.38424CBA31AEF41A.title: "Fossil"
	quest.38EB49361605C5E3.quest_desc: ["Ruins among the red cliffs."]
	quest.38EB49361605C5E3.title: "Badlands Ruins"
	quest.3941662BD692035B.quest_desc: ["Heat into rotation."]
	quest.3941662BD692035B.title: "Stirling Engine"
	quest.39D24F2994467FEB.quest_desc: ["They hunt in packs."]
	quest.39D24F2994467FEB.title: "Dread Hounds"
	quest.3A2B381694E7803D.quest_desc: ["A pair of wheels crushes ore with a bonus. The reward is a Smashing book: your pickaxe cracks ore into crushed ore."]
	quest.3A2B381694E7803D.title: "Crushing Wheels"
	quest.3B0147D256A72E76.quest_desc: ["A knife cuts grass into straw and meat into cuts. The kitchen starts here. AppleSkin shows how filling each dish is."]
	quest.3B0147D256A72E76.title: "Knife"
	quest.3B1137C51525EBB2.quest_desc: ["A full set of goat fur armour."]
	quest.3B1137C51525EBB2.title: "Full Fur"
	quest.3B51F18BE0C1DC07.quest_desc: ["The burner heats the air in the envelope."]
	quest.3B51F18BE0C1DC07.title: "Hot Air Burner"
	quest.3B7110855E76678A.quest_desc: ["Grinds grain into flour and ore into grit."]
	quest.3B7110855E76678A.title: "Millstone"
	quest.3C624DE76152228A.quest_desc: ["Someone was digging here before you."]
	quest.3C624DE76152228A.title: "Archeologists' Camp"
	quest.3C7B37315B41515F.quest_desc: ["Brew a potion of rampage."]
	quest.3C7B37315B41515F.title: "Rampage"
	quest.3C8B601B55377999.quest_desc: ["Go down into any cave biome."]
	quest.3C8B601B55377999.title: "Underground"
	quest.3D179F6DFD4604EE.quest_desc: ["Kill 30 skeletons. The reward is a Vorpal book: a chance of a crushing blow and of taking a head."]
	quest.3D179F6DFD4604EE.title: "Skeletons"
	quest.3D45ADEF2443829A.quest_desc: ["Find the trial chambers underground and get a trial key."]
	quest.3D45ADEF2443829A.title: "Trial Chambers"
	quest.3D852B29B66B7CE6.quest_desc: ["Collect 3 wither skeleton skulls."]
	quest.3D852B29B66B7CE6.title: "Skulls"
	quest.3DC87E3032B044AB.quest_desc: ["Fuel made of thorium."]
	quest.3DC87E3032B044AB.title: "Nuclear Fuel"
	quest.3E7BA3D77DAA1ED3.quest_desc: ["A full set of dark metal. In this pack it gives Strength I."]
	quest.3E7BA3D77DAA1ED3.title: "Chaos Knight"
	quest.3F0DD4D605F5FA46.quest_desc: ["Heat the blend and it crystallises. Levitite holds a ship up, but can't lift it on its own."]
	quest.3F0DD4D605F5FA46.title: "Levitite"
	quest.3F2B1450BCEDB172.quest_desc: ["Dark towers stand only in the north. The bosses of chaos live only here too."]
	quest.3F2B1450BCEDB172.title: "Dark Tower"
	quest.3F3D3BFEDA85A930.quest_desc: ["The eldest of the bonescallers."]
	quest.3F3D3BFEDA85A930.title: "Supreme Bonescaller"
	quest.3F3D52997756353E.quest_desc: ["His axe splits shields too."]
	quest.3F3D52997756353E.title: "Zombie Lumberjack"
	quest.3F4BF63D52649624.quest_desc: ["Funnels take items from chests and put them on belts."]
	quest.3F4BF63D52649624.title: "Funnels"
	quest.3F93180CA875881A.quest_desc: ["Diesel gives rotation without water or wind."]
	quest.3F93180CA875881A.title: "Diesel Engine"
	quest.403796E887FF3760.quest_desc: ["Its shell makes a mace and armour."]
	quest.403796E887FF3760.title: "Thornshell Crab"
	quest.403B1C7C6E38BC53.quest_desc: ["Dough, tomato sauce and minced beef."]
	quest.403B1C7C6E38BC53.title: "Pasta with Meatballs"
	quest.4241441FD3688E2A.quest_desc: ["A skillet fries right over the fire. It hits hard, too."]
	quest.4241441FD3688E2A.title: "Skillet"
	quest.42BF02458E2D99D2.quest_desc: ["Smelt nickel and platinum. Oritech starts with them."]
	quest.42BF02458E2D99D2.title: "Northern Metals"
	quest.430EEFC8CC04719E.quest_desc: ["Mine 5 diamonds. You can't craft a diamond pickaxe yet: its recipe unlocks in the Nether."]
	quest.430EEFC8CC04719E.title: "Diamonds"
	quest.4359A8C06D3B008F.quest_desc: ["A mixer over a basin mixes what you can't craft by hand."]
	quest.4359A8C06D3B008F.title: "Mixer"
	quest.43D38460798BDC87.quest_desc: ["Plant any crop."]
	quest.43D38460798BDC87.title: "First Crop"
	quest.43DA1406139D4AFA.quest_desc: ["Nearly every machine needs an andesite casing."]
	quest.43DA1406139D4AFA.title: "Casings"
	quest.440A8F85CAA3A124.quest_desc: ["Make a brewing stand. Nether wart grows in fortresses."]
	quest.440A8F85CAA3A124.title: "Brewing Stand"
	quest.446F1EF791847FB7.quest_desc: ["Hardly anything attacks you here. A good spot for a camp."]
	quest.446F1EF791847FB7.title: "Warped Forest"
	quest.448A5C767908D1E4.quest_desc: ["The fermenter makes fuel from plants. It's the backup plan without oil."]
	quest.448A5C767908D1E4.title: "Plant Oil"
	quest.4530B3D62C2A74A6.quest_desc: ["You know everything that crawls out of chaos."]
	quest.4530B3D62C2A74A6.title: "Chaos Hunter"
	quest.45FFCDBF36A6DFBD.quest_desc: ["The best knife there is."]
	quest.45FFCDBF36A6DFBD.title: "Netherite Knife"
	quest.460B7A96112A144C.quest_desc: ["End stone powder, zinc and water in a heated mixer."]
	quest.460B7A96112A144C.title: "Levitite Blend"
	quest.46CDA9D5A810A1B4.quest_desc: ["Build a campfire and cook some meat on it. Next comes the kitchen: the Farmer's Delight chapter."]
	quest.46CDA9D5A810A1B4.title: "Campfire Dinner"
	quest.470CD1309BE79D82.quest_desc: ["End stone holds Oritech's platinum ore. Besides the End it exists only in the north."]
	quest.470CD1309BE79D82.title: "End Platinum"
	quest.47932ED33706A4C0.quest_desc: ["Hoglins graze here."]
	quest.47932ED33706A4C0.title: "Crimson Forest"
	quest.47F23E6BC846E84A.quest_desc: ["Deflect an arrow with a shield."]
	quest.47F23E6BC846E84A.title: "Not Today"
	quest.48184452CD411FD3.quest_desc: ["Defeat a Fallen Chaos Knight."]
	quest.48184452CD411FD3.title: "Fallen Knight"
	quest.488FD18B22E2650A.title: "Bone Imp"
	quest.48D30221A261736D.title: "Barrel Zombie"
	quest.48D47269F11D1242.quest_desc: ["An old fort on a mound in the woods."]
	quest.48D47269F11D1242.title: "Motte"
	quest.48F69B71BADEC961.quest_desc: ["Crushing wheels turn end stone into powder. Levitite for airships is made from it (the Sky chapter)."]
	quest.48F69B71BADEC961.title: "End Stone Powder"
	quest.49315C954FA0B6F5.quest_desc: ["Potions, heatproof armour and a road through the Nether: time to head for the hot island."]
	quest.49315C954FA0B6F5.title: "Ready for the South"
	quest.4956927C60DB5470.quest_desc: ["Presses and mixers work over a depot too."]
	quest.4956927C60DB5470.title: "Depot"
	quest.4988A9961035406B.quest_desc: ["Enter the End portal."]
	quest.4988A9961035406B.title: "The End?"
	quest.498A2D2CD3B01050.quest_desc: ["Put the pot on the stove. Soups and stews cook in it."]
	quest.498A2D2CD3B01050.title: "Cooking Pot"
	quest.499AB36B29666371.quest_desc: ["Pour the elixir on an infernal pumpkin and defeat the Lord."]
	quest.499AB36B29666371.title: "Lord Pumpkinhead"
	quest.49A60CFC6CC71D67.quest_desc: ["Charges iron and gold with power."]
	quest.49A60CFC6CC71D67.title: "Energiser"
	quest.49CD56A57D4E55A4.quest_desc: ["Pours fluids into bottles and onto parts."]
	quest.49CD56A57D4E55A4.title: "Spout"
	quest.4A556D7CD9BDBF91.quest_desc: ["Symmetric sails catch the wind."]
	quest.4A556D7CD9BDBF91.title: "Sails"
	quest.4A58EF06E076AC82.quest_desc: ["Walk to the grey shore and step into the Pale. Go no further: the fog is poison."]
	quest.4A58EF06E076AC82.title: "Edge of the World"
	quest.4A8BED839AFA199D.quest_desc: ["It points to where you last died. With the Corpse mod that's the way back to your things. The reward is the ancient Tunneling book: a pickaxe digs several blocks at once."]
	quest.4A8BED839AFA199D.title: "Recovery Compass"
	quest.4AD349C8E447E551.quest_desc: ["Blue fire and soul sand."]
	quest.4AD349C8E447E551.title: "Soul Sand Valley"
	quest.4AF3B98939A68C16.quest_desc: ["An ingot from scrap and gold."]
	quest.4AF3B98939A68C16.title: "Netherite"
	quest.4AF81EC30CC8CB4C.quest_desc: ["Moves items between machines."]
	quest.4AF81EC30CC8CB4C.title: "Mechanical Arm"
	quest.4B0F891B4036C99F.quest_desc: ["Two skulls, one spine."]
	quest.4B0F891B4036C99F.title: "Siamese Skeletons"
	quest.4C0B6CC591520C05.quest_desc: ["The base of everything in Create: andesite and iron nuggets."]
	quest.4C0B6CC591520C05.title: "Andesite Alloy"
	quest.4C3B43921837B846.quest_desc: ["The fastest brush."]
	quest.4C3B43921837B846.title: "Netherite Brush"
	quest.4C8251E4D1C6AA30.quest_desc: ["A controller on a column of fluid tanks splits oil into fractions."]
	quest.4C8251E4D1C6AA30.title: "Distillation"
	quest.4CBE9AD642E91296.quest_desc: ["Nasty things in the water."]
	quest.4CBE9AD642E91296.title: "Carrion Fish"
	quest.4D2A2718A56AA656.quest_desc: ["Fur armour keeps you warm."]
	quest.4D2A2718A56AA656.title: "Goat Fur"
	quest.4DAA5FFB4B8FBD43.quest_desc: ["Lives by the water."]
	quest.4DAA5FFB4B8FBD43.title: "Zombie Fisherman"
	quest.4DE3B4D8BEDB744D.quest_desc: ["A brush sweeps suspicious sand and gravel."]
	quest.4DE3B4D8BEDB744D.title: "Brush"
	quest.4DE8002A1CA820C6.quest_desc: ["Turns a build into a flying body."]
	quest.4DE8002A1CA820C6.title: "Physics Assembler"
	quest.4E4C20E946F41672.quest_desc: ["The heart of Create's advanced machines."]
	quest.4E4C20E946F41672.title: "Precision Mechanism"
	quest.4E4E427D54CEA209.quest_desc: ["What's left from distillation becomes asphalt. You run faster on it."]
	quest.4E4E427D54CEA209.title: "Asphalt"
	quest.4ED7BFC0BBD81AF3.quest_desc: ["A docking connector couples two ships."]
	quest.4ED7BFC0BBD81AF3.title: "Docking"
	quest.4F2C221048E9A69F.quest_desc: ["Hits hard."]
	quest.4F2C221048E9A69F.title: "Zombie Bruiser"
	quest.4F3DD01B4E09985C.quest_desc: ["Eat a hot soup or stew in the north: warm food warms your body for a minute."]
	quest.4F3DD01B4E09985C.title: "Hot Dinner"
	quest.4FDFE63DCAAA6E64.quest_desc: ["You have been to all five Nether biomes."]
	quest.4FDFE63DCAAA6E64.title: "Hot Tourist"
	quest.4FEBB1AD4B9148A2.quest_desc: ["Make some torches. The reward unlocks the ladder recipe."]
	quest.4FEBB1AD4B9148A2.title: "Torches"
	quest.5030EEC3E619C095.quest_desc: ["A hoglin hide chestplate keeps the heat out. The hot island is hard without one."]
	quest.5030EEC3E619C095.title: "Heatproof Armour"
	quest.504DC36A93504B96.quest_desc: ["A propeller bearing on a brass casing."]
	quest.504DC36A93504B96.title: "Propeller"
	quest.50B8518015D93474.quest_desc: ["Shulker shells for boxes."]
	quest.50B8518015D93474.title: "Shulkers"
	quest.517FB6433E9F7852.quest_desc: ["Tunnels under the southern jungle."]
	quest.517FB6433E9F7852.title: "Catacombs"
	quest.52C48897B0391DA4.quest_desc: ["Permafrost shards. The Frostbitten Blade is forged from them."]
	quest.52C48897B0391DA4.title: "Permafrost"
	quest.52D4A2355D369CE6.quest_desc: ["Caves explored, iron on. Take a longer fire resistance."]
	quest.52D4A2355D369CE6.title: "Ready for the Heat"
	quest.52EDA5B89A3F0F77.quest_desc: ["Give the train a schedule and a conductor and it runs on its own."]
	quest.52EDA5B89A3F0F77.title: "Schedule"
	quest.542EEAE5163E7784.quest_desc: ["Pipes for items and energy."]
	quest.542EEAE5163E7784.title: "Pipes"
	quest.54320B3D256A2A18.quest_desc: ["A jumping blow stuns."]
	quest.54320B3D256A2A18.title: "Skullbreaker Hammer"
	quest.543F9A4131886D34.quest_desc: ["New Age's reactor casing and glass."]
	quest.543F9A4131886D34.title: "Reactor Casing"
	quest.54C4910398E90581.quest_desc: ["Armour from a chameleon's molt adapts to heat and cold."]
	quest.54C4910398E90581.title: "Chameleon"
	quest.551B2870D03B979D.quest_desc: ["Cools your home when it's scorching outside."]
	quest.551B2870D03B979D.title: "Icebox"
	quest.558294EEFE87A521.quest_desc: ["Lifts cargo on a rope."]
	quest.558294EEFE87A521.title: "Rope Winch"
	quest.55876116D09A4A94.quest_desc: ["Elytra go into their own slot (Elytra Slot), so your chestplate stays on. Fly north in a fur-lined chestplate."]
	quest.55876116D09A4A94.title: "Wing Slot"
	quest.55D4D3D02F97AA25.quest_desc: ["JEI shows recipes: hover an item and press R (how to make it) or U (what it is used in). Pale Store locks some recipes until a quest opens them: the bed, the ladder, the diamond pickaxe. JEI's Recipe Store tab shows which quest you need."]
	quest.55D4D3D02F97AA25.title: "Recipes"
	quest.55DF5029BDD9D4A4.quest_desc: ["500 blocks of track through the Nether. Steam 'n' Rails adds tracks of many materials, blackstone among them."]
	quest.55DF5029BDD9D4A4.title: "Tracks"
	quest.55F61DC887EC3D52.quest_desc: ["The augmentation center installs upgrades right into your body."]
	quest.55F61DC887EC3D52.title: "Cybernetics"
	quest.5665ADEFB6FFF58A.quest_desc: ["The boss drops the Heart of the Pale. Hold use in the Overworld and the Pale is gone for good: the poison stops, the fog lifts, and new lands appear beyond the sea."]
	quest.5665ADEFB6FFF58A.title: "Clear Water"
	quest.57663AC209CBDFA4.quest_desc: ["Every kill stokes your Rampage."]
	quest.57663AC209CBDFA4.title: "Great Reaper Axe"
	quest.57A1A48BA09D73DC.quest_desc: ["AppleSkin shows in a food's tooltip how much hunger and saturation it restores, and the hunger bar shows your hidden saturation."]
	quest.57A1A48BA09D73DC.title: "Saturation"
	quest.588E282B1E8AB802.quest_desc: ["A pump and pipes move water, lava and anything that flows."]
	quest.588E282B1E8AB802.title: "Pump"
	quest.59E931CC418BB150.quest_desc: ["Wash gravel: it yields nuggets."]
	quest.59E931CC418BB150.title: "Washing"
	quest.5AA9D3A0BBDF9E40.quest_desc: ["A semaphore shows whether the line is clear."]
	quest.5AA9D3A0BBDF9E40.title: "Semaphore"
	quest.5B71CDC2F2AAF30C.quest_desc: ["Find a pillager outpost. They keep their distance from villages. The cages next to them sometimes hold allays."]
	quest.5B71CDC2F2AAF30C.title: "Pillager Outpost"
	quest.5BF65E1459529D27.title: "Decaying Zombie"
	quest.5C108A9D1926801A.quest_desc: ["The recipe is open. Craft a diamond pickaxe: you need it for debris and obsidian."]
	quest.5C108A9D1926801A.title: "Diamond Pickaxe"
	quest.5C312FD6A139D129.quest_desc: ["Find an ocean monument off the shore. Bring water breathing potions."]
	quest.5C312FD6A139D129.title: "Ocean Monument"
	quest.5DB63DF388B56201.quest_desc: ["Lord Pumpkinhead's sword. The best weapon against what comes out of the fog."]
	quest.5DB63DF388B56201.title: "Soulbane"
	quest.5DBB3C9CFBE1A7F0.quest_desc: ["A mechanical hand that clicks for you."]
	quest.5DBB3C9CFBE1A7F0.title: "Deployer"
	quest.5DF86C2C9CDC9B68.quest_desc: ["A solar heating plate. There's plenty of sun in the south."]
	quest.5DF86C2C9CDC9B68.title: "Southern Sun"
	quest.5E1F5A5408C7DBDF.quest_desc: ["Crafts big recipes on its own."]
	quest.5E1F5A5408C7DBDF.title: "Mechanical Crafter"
	quest.5E60743011A9253E.quest_desc: ["The obelisk stands in the desert of the hot island."]
	quest.5E60743011A9253E.title: "Desert Obelisk"
	quest.5E7BAB9E0D663E8E.quest_desc: ["The common monsters of the mild island are crossed off. Next on the list are those who live on the other islands."]
	quest.5E7BAB9E0D663E8E.title: "The First Page"
	quest.5E872F3E60538106.quest_desc: ["Archeologists' bombs turn up in digs. Throw one."]
	quest.5E872F3E60538106.title: "Bomb"
	quest.5F45460CF8DB57E9.quest_desc: ["Fill an airtight envelope with hot air."]
	quest.5F45460CF8DB57E9.title: "Head in the Clouds"
	quest.5F7D080C32D1BF06.quest_desc: ["Mine some coal."]
	quest.5F7D080C32D1BF06.title: "Coal"
	quest.5FB5FE0EDFF8E665.quest_desc: ["Plastic sheets for electronics."]
	quest.5FB5FE0EDFF8E665.title: "Plastic"
	quest.605394987530A0D3.quest_desc: ["A beacon has a Blessing tab. An amulet receives, in order: Lava Walker, Heaven's Fall (no fall damage and a shockwave) and Holy Trinity (three shields, works from the hotbar). Higher blessings need a taller beacon and more levels. Tick this off once you have the first."]
	quest.605394987530A0D3.title: "Amulet Blessings"
	quest.60C79CE55B3A8D6D.quest_desc: ["Upgrade a diamond pickaxe at a smithing table."]
	quest.60C79CE55B3A8D6D.title: "Netherite Pickaxe"
	quest.613049AD6949A8E3.quest_desc: ["Copper and zinc in a heated basin."]
	quest.613049AD6949A8E3.title: "Brass"
	quest.614CFE4398E3FC6C.quest_desc: ["Defeat the Lifestealer."]
	quest.614CFE4398E3FC6C.title: "Lifestealer"
	quest.6167BC54D7B958AC.quest_desc: ["It's a long flight. Bring plenty of rockets."]
	quest.6167BC54D7B958AC.title: "Rockets"
	quest.6257C11FF030B148.quest_desc: ["Beef stew is more filling and warms you too."]
	quest.6257C11FF030B148.title: "Stew"
	quest.62BF3F56EC398E2B.quest_desc: ["Climb above 500 blocks: no fog and no poison up there. Below lies a sea of clouds with the islands as holes in it."]
	quest.62BF3F56EC398E2B.title: "Above the Clouds"
	quest.62E270CAA72A54D7.quest_desc: ["Oritech's laser mines and powers things from afar."]
	quest.62E270CAA72A54D7.title: "Enderic Laser"
	quest.635516F1AD254645.quest_desc: ["Artifacts are identified on it."]
	quest.635516F1AD254645.title: "Archeology Table"
	quest.638535B94E3F540A.quest_desc: ["Defeat an elder guardian."]
	quest.638535B94E3F540A.title: "Elder Guardian"
	quest.63B83E7FF2A56CF8.quest_desc: ["An iron pickaxe can mine diamonds. The fire resistance reward helps around lava."]
	quest.63B83E7FF2A56CF8.title: "Iron Pickaxe"
	quest.641005752AAF6989.quest_desc: ["Run a propeller on a ship."]
	quest.641005752AAF6989.title: "Thrust"
	quest.653992FFD62EEE01.quest_desc: ["All three strongholds are on the hot island, half way out from its centre. Find one to open the End chapter."]
	quest.653992FFD62EEE01.title: "Stronghold"
	quest.6541143ABF1D324D.quest_desc: ["Land ends about 1250 blocks from here. Past it lies a grey, poisonous sea behind a wall of fog. Two more islands wait somewhere beyond it. Start small."]
	quest.6541143ABF1D324D.title: "Grey Horizon"
	quest.655E5A51D507619D.quest_desc: ["Bring 15 bookshelves (they are not taken) and place them around the table: that gives the strongest enchantments."]
	quest.655E5A51D507619D.title: "Full Power"
	quest.65767D70F184842D.quest_desc: ["Put a whole dish on the table: roast chicken, shepherd's pie or a glazed ham."]
	quest.65767D70F184842D.title: "Feast"
	quest.6603C07C2CAABA6D.quest_desc: ["A station by each portal, and signals in between."]
	quest.6603C07C2CAABA6D.title: "Stations"
	quest.662C24D6541B96D3.quest_desc: ["A drill for an underground machine."]
	quest.662C24D6541B96D3.title: "Borehead"
	quest.66BB1CC21F626DDD.quest_desc: ["Straw is woven into canvas."]
	quest.66BB1CC21F626DDD.title: "Canvas"
	quest.66E7BBE525F27832.quest_desc: ["You are in the Nether. One block here is eight in the Overworld, so the hot island is only about 500 blocks south. Look around first: fortresses, bastions and debris are close, and you will need them."]
	quest.66E7BBE525F27832.title: "A Warm Welcome"
	quest.66FBABA20A32879D.quest_desc: ["A well full of fire."]
	quest.66FBABA20A32879D.title: "Firewell"
	quest.6732D54B22BF2CF3.quest_desc: ["Find an End city past the outer islands."]
	quest.6732D54B22BF2CF3.title: "End City"
	quest.673D685E0A156DFF.quest_desc: ["Find a swamp. Wild rice grows there, and witches live there."]
	quest.673D685E0A156DFF.title: "Swamp"
	quest.67433EA0672EC136.quest_desc: ["The north's skeletons shoot slowing arrows."]
	quest.67433EA0672EC136.title: "Strays"
	quest.677A51A20857BF86.quest_desc: ["An angel receives: Heavenly Grace (rockets push your elytra 50% faster while the angel is near), Intercession (heals you at low health) and Unfading Light (more charge). Tick this off once you have the first."]
	quest.677A51A20857BF86.title: "Angel Blessings"
	quest.6979AD411F5C780D.quest_desc: ["A chestplate of monster skin and dark metal."]
	quest.6979AD411F5C780D.title: "Mantle of the Night"
	quest.69AD1F3470900340.quest_desc: ["It shows height and air pressure. Pressure drops with height, and so does thrust."]
	quest.69AD1F3470900340.title: "Altitude Sensor"
	quest.69D79ACF1091D28A.quest_desc: ["Slay the Ender Dragon."]
	quest.69D79ACF1091D28A.title: "The Dragon"
	quest.6A1F76BBF7EF695D.quest_desc: ["A small propeller for fine moves."]
	quest.6A1F76BBF7EF695D.title: "Smart Propeller"
	quest.6B8706B49E27FEEF.quest_desc: ["Give an allay an enchanted golden apple: it becomes a Guardian Amulet. Hold it in either hand and holy shields reflect projectiles flying at you."]
	quest.6B8706B49E27FEEF.title: "Guardian Amulet"
	quest.6BB18A9229DC45A1.quest_desc: ["You crossed all three islands and beat everything that hid in the north. What is left lives in the fog itself. The last chapter is open: the Pale."]
	quest.6BB18A9229DC45A1.title: "Master of Three Islands"
	quest.6BBFE927BFD7CC3F.quest_desc: ["The scanner shows how much oil lies under a chunk. Search the desert, badlands and savanna: there is none on the other islands."]
	quest.6BBFE927BFD7CC3F.title: "Prospecting"
	quest.6C204740A618AA15.quest_desc: ["Take a ship as high as it goes. Around height 300 there's no air left, and the ship stops. Above 450, where the poison ends, nobody can stand on a deck: the Pale only lets go of those on wings."]
	quest.6C204740A618AA15.title: "The Pale's Ceiling"
	quest.6C7E43831A5017C0.quest_desc: ["A stressometer shows how much more load your network can take."]
	quest.6C7E43831A5017C0.title: "Stress"
	quest.6CA11DA32F4F7DDE.quest_desc: ["Find a Nether fortress."]
	quest.6CA11DA32F4F7DDE.title: "Fortress"
	quest.6D38E250FBC69D36.quest_desc: ["Copper wire and connectors."]
	quest.6D38E250FBC69D36.title: "Wires"
	quest.6D95516F6EF1521C.quest_desc: ["Curios adds slots: rings, a necklace, a belt, a back slot and more. Relics go there, and elytra take their own slot instead of your chestplate."]
	quest.6D95516F6EF1521C.title: "Trinket Slots"
	quest.6DAD2F9960A4AC46.quest_desc: ["Place a respawn anchor in the Nether, charge it fully (4 glowstone) and use it to set your spawn. While it is charged you keep your inventory and experience when you die. Each respawn uses one charge. Items in the elytra slot drop as usual."]
	quest.6DAD2F9960A4AC46.title: "Respawn Anchor"
	quest.6DD0B934A341F1F9.quest_desc: ["Wild rice grows in swamps and jungles. Plant it in water."]
	quest.6DD0B934A341F1F9.title: "Rice"
	quest.6E36748374FCDE66.quest_desc: ["Wild tomatoes only grow where it's hot. That means the hot island."]
	quest.6E36748374FCDE66.title: "Tomatoes"
	quest.6E4CB3B7BB11E21C.quest_desc: ["Build a portal in the Nether around x 0, z 500 and step out onto the hot island. Find the desert. Drink water and watch your thermometer: without hoglin hide or cooling you overheat fast here."]
	quest.6E4CB3B7BB11E21C.title: "Southern Sands"
	quest.6E686D1726C68213.quest_desc: ["A big store made of iron sheets."]
	quest.6E686D1726C68213.title: "Item Vault"
	quest.6E6D548EDA475B8D.quest_desc: ["Find a witch hut in the swamp."]
	quest.6E6D548EDA475B8D.title: "Witch Hut"
	quest.6E971D363EF56B43.quest_desc: ["Deep beneath the island. Keep quiet: the Warden walks there."]
	quest.6E971D363EF56B43.title: "Ancient City"
	quest.6EC0881D3B8DE0C1.quest_desc: ["Enchants for power and souls, and lets you pick the enchantment."]
	quest.6EC0881D3B8DE0C1.title: "Stabilized Enchanter"
	quest.6EE5AAD137ED2402.quest_desc: ["Defeat the Mother Spider."]
	quest.6EE5AAD137ED2402.title: "Mother Spider"
	quest.6EFA5BF4CC56454A.quest_desc: ["Explodes twice."]
	quest.6EFA5BF4CC56454A.title: "Phantom Creeper"
	quest.6F36D9DB36D90C0D.quest_desc: ["Kill the boss. Cut the tentacles first: while they hold, the body takes next to no damage. Then the face and the hand, then the main eye while it is open. Everybody near gets the advancement."]
	quest.6F36D9DB36D90C0D.title: "The Patchwork Abomination"
	quest.705078B80524B8F8.quest_desc: ["Oritech's first generator burns coal."]
	quest.705078B80524B8F8.title: "Basic Generator"
	quest.70D959C60DCE3CA1.quest_desc: ["Pumpkinhead and his bruisers."]
	quest.70D959C60DCE3CA1.title: "The Pumpkin Gang"
	quest.7124E0DD608F7300.quest_desc: ["Dry savanna between the desert and the jungle. Here, in the desert and in the badlands, oil lies underground."]
	quest.7124E0DD608F7300.title: "Savanna"
	quest.71B68E3780D7E7E9.quest_desc: ["Find a stone circle on the plains."]
	quest.71B68E3780D7E7E9.title: "Stone Circle"
	quest.71D741031868AB0C.quest_desc: ["Evil pumpkins grow here."]
	quest.71D741031868AB0C.title: "Cursed Farm"
	quest.72F34CE7789BE0DF.quest_desc: ["A reactor, exo armour, prometheum: Oritech is done."]
	quest.72F34CE7789BE0DF.title: "Northern Industry"
	quest.72F4E7B325137CB1.quest_desc: ["A steering wheel and a throttle lever."]
	quest.72F4E7B325137CB1.title: "Steering"
	quest.72F9FEBA0B99A12B.quest_desc: ["Deep in the Nether, below y 20. Needs a diamond pickaxe."]
	quest.72F9FEBA0B99A12B.title: "Ancient Debris"
	quest.73B6764D68F79C2D.quest_desc: ["Defeat the Missioner."]
	quest.73B6764D68F79C2D.title: "Missioner"
	quest.73CB050C8F07B87F.quest_desc: ["The hounds' lair."]
	quest.73CB050C8F07B87F.title: "Mound of Hounds"
	quest.73FB8B12389506A9.quest_desc: ["The only way to the cold island: a Nether portal won't open there, and airships can't climb above the fog. Find elytra in the ship by an End city to open the Cold Island chapter."]
	quest.73FB8B12389506A9.title: "Elytra"
	quest.74270BCBAB292772.quest_desc: ["Dig up a cursed grave."]
	quest.74270BCBAB292772.title: "Graves"
	quest.751A7F9EC9808B4B.quest_desc: ["Oritech's exo armour from northern metals."]
	quest.751A7F9EC9808B4B.title: "Exo Armour"
	quest.75903FFDBAF9F5C8.quest_desc: ["Fill a bucket with diesel."]
	quest.75903FFDBAF9F5C8.title: "Diesel"
	quest.7697D66FB4E0E128.quest_desc: ["A stove heats whatever stands on it."]
	quest.7697D66FB4E0E128.title: "Stove"
	quest.76D15F539177341F.quest_desc: ["It hunts in the dark."]
	quest.76D15F539177341F.title: "Nightmare Stalker"
	quest.77BCEC682CE4FE4C.quest_desc: ["Another fraction."]
	quest.77BCEC682CE4FE4C.title: "Gasoline"
	quest.78126D00318DA7F3.quest_desc: ["Red cliffs in the east."]
	quest.78126D00318DA7F3.title: "Badlands"
	quest.790C09D2C9FEC09D.quest_desc: ["Sneak and right-click a chest with empty hands: Carry On lets you pick it up with everything inside. Animals too."]
	quest.790C09D2C9FEC09D.title: "Moving House"
	quest.792CDBE113F961A3.quest_desc: ["A heavy core from a vault and a breeze rod."]
	quest.792CDBE113F961A3.title: "Mace"
	quest.799E7F1C5D6A46BF.quest_desc: ["The hot island lies 3500 to 4500 blocks south; in the Nether that is 8 times closer. Head south to around x 0, z 500 (x −60 to 60, z 440 to 560). A portal built there leads to the hot island."]
	quest.799E7F1C5D6A46BF.title: "The Road South"
	quest.79BC6FA18749A3B5.quest_desc: ["For better wires and magnets."]
	quest.79BC6FA18749A3B5.title: "Overcharged Gold"
	quest.7A2A3B6158360931.quest_desc: ["Find trail ruins and dig up a sherd."]
	quest.7A2A3B6158360931.title: "Trail Ruins"
	quest.7A2BCD9950313F2F.quest_desc: ["Find a desert pyramid. Mind the floor."]
	quest.7A2BCD9950313F2F.title: "Pyramid"
	quest.7A4739014C49CFD3.quest_desc: ["Cocoa beans grow on jungle trunks. They make the hot cocoa you will want in the north."]
	quest.7A4739014C49CFD3.title: "Cocoa"
	quest.7A9515C9230365CA.quest_desc: ["A water wheel and some cogs give you your first rotation."]
	quest.7A9515C9230365CA.title: "Water Power"
	quest.7B503FD5B2AE693A.quest_desc: ["There were none on the mild island. Here there are. Kill three door knights and two bonescallers. The rest are written down in the Death List chapter."]
	quest.7B503FD5B2AE693A.title: "Spawn of Chaos"
	quest.7B988246F90F6F1C.quest_desc: ["The Missioner drops charms. Collect three different ones."]
	quest.7B988246F90F6F1C.title: "Charms"
	quest.7C20E04BF684FF68.quest_desc: ["Build a reactor with heat vents. Keep it far from home."]
	quest.7C20E04BF684FF68.title: "Reactor"
	quest.7C24CF8E8AEE2B20.title: "Decrepit Skeleton"
	quest.7C80E07D1FEFD966.quest_desc: ["Allays sit in cages by pillager outposts and in woodland mansions. Free one, hand it an item and have it bring you another."]
	quest.7C80E07D1FEFD966.title: "A Friend in a Cage"
	quest.7D512533CA7EC7A3.quest_desc: ["Put food on it, hit it with a knife, get slices."]
	quest.7D512533CA7EC7A3.title: "Cutting Board"
	quest.7D7FFD8C48C4CE4C.quest_desc: ["Put an unidentified artifact on the archeology table. It turns into a book with one of three ancient enchantments: Soaring Winds, Penetrating Strike or Tunneling."]
	quest.7D7FFD8C48C4CE4C.title: "Identify an Artifact"
	quest.7E137323D2F00F6F.quest_desc: ["Oritech's nickel, platinum and uranium exist only on the cold island. Mine nickel and platinum to open the Oritech chapter."]
	quest.7E137323D2F00F6F.title: "Northern Ores"
	quest.7E599DE624740DA1.quest_desc: ["A soul-fire lamp keeps the temperature around you steady. Useful both south and north."]
	quest.7E599DE624740DA1.title: "Soulspring Lamp"
	quest.7E9F3C3908AE7FEE.quest_desc: ["It eats diamond ore."]
	quest.7E9F3C3908AE7FEE.title: "Diamond Termite"
	quest.7EBD1CB374F2E544.quest_desc: ["Crushed ore plus washing gives more metal."]
	quest.7EBD1CB374F2E544.title: "Crushed Ore"
	quest.7F3272C01B2E930F.quest_desc: ["Kill 30 zombies. The reward is a Leech book: killing a mob heals you."]
	quest.7F3272C01B2E930F.title: "Zombies"
	quest.7FAA8C6F650E5E31.quest_desc: ["Find the ice spikes."]
	quest.7FAA8C6F650E5E31.title: "Ice Spikes"
	reward_table.0E28176B09638154.title: "Iron Tool"
	reward_table.23C91D56D4883B5C.title: "Efficiency Book"
	reward_table.36E06677A3FA83E2.title: "Fire Protection Book"
	reward_table.412962825CC1473A.title: "Insight Book"
	reward_table.52C654FC8A195807.title: "Protection Book"
	reward_table.5A70F74861CA7022.title: "Sharpness Book"
}
