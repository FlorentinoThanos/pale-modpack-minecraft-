	quest.65FEB118B7BA1765.quest_desc: ["Sew heat protection into your armour at the sewing table."]
	quest.65FEB118B7BA1765.title: "Insulation"
	quest.6732D54B22BF2CF3.quest_desc: ["Find an End city past the outer islands."]
	quest.6732D54B22BF2CF3.title: "End City"
	quest.67433EA0672EC136.quest_desc: ["The north's skeletons shoot slowing arrows."]
	quest.67433EA0672EC136.title: "Strays"
	quest.6761B1DEDF496C79.quest_desc: ["A full set of iron armour."]
	quest.6761B1DEDF496C79.title: "Iron Armour"
	quest.6979AD411F5C780D.quest_desc: ["A chestplate of monster skin and dark metal."]
	quest.6979AD411F5C780D.title: "Mantle of the Night"
	quest.6A1F76BBF7EF695D.quest_desc: ["A small propeller for fine moves."]
	quest.6A1F76BBF7EF695D.title: "Smart Propeller"
	quest.6BB18A9229DC45A1.quest_desc: ["You crossed all three islands and beat everything that hid in the north."]
	quest.6BB18A9229DC45A1.title: "Master of the Pale"
	quest.6D38E250FBC69D36.quest_desc: ["Copper wire and connectors."]
	quest.6D38E250FBC69D36.title: "Wires"
	quest.6DEBB1F3E3BB250B.quest_desc: ["A station by each portal."]
	quest.6DEBB1F3E3BB250B.title: "Stations"
	quest.6EE5AAD137ED2402.quest_desc: ["Defeat the Mother Spider."]
	quest.6EE5AAD137ED2402.title: "Mother Spider"
	quest.6EFA5BF4CC56454A.quest_desc: ["Explodes twice."]
	quest.6EFA5BF4CC56454A.title: "Phantom Creeper"
	quest.70D959C60DCE3CA1.quest_desc: ["Pumpkinhead and his bruisers."]
	quest.70D959C60DCE3CA1.title: "The Pumpkin Gang"
	quest.70DEC128677ACF04.quest_desc: ["Create's machines need it."]
	quest.70DEC128677ACF04.title: "Quartz"
	quest.7124E0DD608F7300.quest_desc: ["Dry savanna between the desert and the jungle."]
	quest.7124E0DD608F7300.title: "Savanna"
	quest.72AFD2AB490C73FB.quest_desc: ["Assemble a train: a bogey on the tracks, casing, controls."]
	quest.72AFD2AB490C73FB.title: "Train"
	quest.73B6764D68F79C2D.quest_desc: ["Defeat the Missioner."]
	quest.73B6764D68F79C2D.title: "Missioner"
	quest.73FB8B12389506A9.quest_desc: ["The only way to the cold island. A portal from the Nether won't open there."]
	quest.73FB8B12389506A9.title: "Elytra"
	quest.75903FFDBAF9F5C8.quest_desc: ["Fill a bucket with diesel."]
	quest.75903FFDBAF9F5C8.title: "Diesel"
	quest.76D15F539177341F.quest_desc: ["It hunts in the dark."]
	quest.76D15F539177341F.title: "Nightmare Stalker"
	quest.7703C7EC764575C8.quest_desc: ["Useful against arrows and against what lives on the other islands."]
	quest.7703C7EC764575C8.title: "Shield"
	quest.78126D00318DA7F3.quest_desc: ["Red cliffs in the east."]
	quest.78126D00318DA7F3.title: "Badlands"
	quest.7A2A3B6158360931.quest_desc: ["Find trail ruins and dig up a sherd."]
	quest.7A2A3B6158360931.title: "Trail Ruins"
	quest.7A4739014C49CFD3.quest_desc: ["Cocoa beans grow on jungle trunks."]
	quest.7A4739014C49CFD3.title: "Cocoa"
	quest.7AB4822E28BE3D8A.quest_desc: ["Oritech has its own oil in springs: those are only in the south too."]
	quest.7AB4822E28BE3D8A.title: "Oil Spring"
	quest.7B988246F90F6F1C.quest_desc: ["The Missioner drops charms. Collect three different ones."]
	quest.7B988246F90F6F1C.title: "Charms"
	quest.7C20E04BF684FF68.quest_desc: ["Build a reactor with heat vents. Keep it far from home."]
	quest.7C20E04BF684FF68.title: "Reactor"
	quest.7C24CF8E8AEE2B20.title: "Decrepit Skeleton"
	quest.7D512533CA7EC7A3.quest_desc: ["Put food on it, hit it with a knife, get slices."]
	quest.7D512533CA7EC7A3.title: "Cutting Board"
	quest.7D928C9992FECDFD.quest_desc: ["Create's zinc ore lies shallow. Without it there is no brass."]
	quest.7D928C9992FECDFD.title: "Zinc"
	quest.7E137323D2F00F6F.quest_desc: ["Nickel, platinum and uranium exist only on the cold island."]
	quest.7E137323D2F00F6F.title: "Northern Ores"
	quest.7EBD1CB374F2E544.quest_desc: ["Crushed ore plus washing gives more metal."]
	quest.7EBD1CB374F2E544.title: "Crushed Ore"
	quest.7FAA8C6F650E5E31.quest_desc: ["Find the ice spikes."]
	quest.7FAA8C6F650E5E31.title: "Ice Spikes"
	quest.8315F2415B866728.title: "Firelight"
	quest.83294AA7A21B24F9.quest_desc: ["Krampus' horn and permafrost make a horn of snowstorms."]
	quest.83294AA7A21B24F9.title: "Stormcaller's Horn"
	quest.83C119B689CF5F32.quest_desc: ["Gather dark metal ingots and forge a chestplate."]
	quest.83C119B689CF5F32.title: "Dark Metal"
	quest.8448AC785A06ADA3.quest_desc: ["Nether quartz and redstone. Polish it and make an electron tube."]
	quest.8448AC785A06ADA3.title: "Rose Quartz"
	quest.84E8CC486B087199.quest_desc: ["You can't mine obsidian without a diamond pickaxe, and its recipe only unlocks in the Nether. So cast the portal in place: build a stone mould, pour lava into each frame cell and pour water over it. The lava turns into obsidian right in the frame. Ruined portals also hold ready obsidian."]
	quest.84E8CC486B087199.title: "Cast Portal"
	quest.8580B33A9D0FFD4D.quest_desc: ["Found while digging. Shards make up an artifact."]
	quest.8580B33A9D0FFD4D.title: "Artifact Shards"
	quest.884AB390024C4487.quest_desc: ["Fill a bucket with crude oil."]
	quest.884AB390024C4487.title: "Crude Oil"
	quest.88C63890BCA3FB67.quest_desc: ["Oritech's laser arm mines from afar."]
	quest.88C63890BCA3FB67.title: "Laser Arm"
	quest.88E43EDD19DAD254.quest_desc: ["Wither skeleton skulls from the fortress."]
	quest.88E43EDD19DAD254.title: "Skulls"
	quest.8B0F1DC398076B5B.quest_desc: ["Create New Age's thorium ore exists only on the cold island, next to Oritech's uranium."]
	quest.8B0F1DC398076B5B.title: "Thorium"
	quest.8C29D21D55168A37.quest_desc: ["Insulate a full set of armour at the sewing table."]
	quest.8C29D21D55168A37.title: "Fully Insulated"
	quest.8C9D2F40DB85901F.quest_desc: ["His hammer stuns."]
	quest.8C9D2F40DB85901F.title: "Skeleton Thrasher"
	quest.8E586753D20A5A43.quest_desc: ["Armour from crab shells."]
	quest.8E586753D20A5A43.title: "Spiny Shell Armour"
	quest.902FBF4C0345BAC6.quest_desc: ["Steam 'n' Rails' little handcar, for checking the line."]
	quest.902FBF4C0345BAC6.title: "Handcar"
	quest.90EADDECB31F69A8.quest_desc: ["Chorus fruit from the outer islands."]
	quest.90EADDECB31F69A8.title: "Chorus"
	quest.910FEA79D7E519D8.quest_desc: ["Killing a mob heals you."]
	quest.910FEA79D7E519D8.title: "Leech"
	quest.9168863FAED2584D.quest_desc: ["Sews insulation right into your armour, for heat or for cold."]
	quest.9168863FAED2584D.title: "Sewing Table"
	quest.91E96124CD295ED1.quest_desc: ["The nastiest place in the Nether."]
	quest.91E96124CD295ED1.title: "Basalt Deltas"
	quest.9249DF6F4BA122E6.quest_desc: ["A water wheel and some cogs give you your first rotation."]
	quest.9249DF6F4BA122E6.title: "Water Power"
	quest.92B0A497F3B3C723.quest_desc: ["Keeps a ship on course."]
	quest.92B0A497F3B3C723.title: "Navigation Table"
	quest.96662A2C539A4849.quest_desc: ["Find an ocean monument off the shore. Bring water breathing potions."]
	quest.96662A2C539A4849.title: "Ocean Monument"
	quest.96B8A826CE2236BB.quest_desc: ["Find a grassy burial mound."]
	quest.96B8A826CE2236BB.title: "Burial Mound"
	quest.9A14DAD479DC44C0.quest_desc: ["Small but annoying."]
	quest.9A14DAD479DC44C0.title: "Flies and Gadflies"
	quest.9AA6D5A556DD3D2D.quest_desc: ["Keep your distance: he throws bombs."]
	quest.9AA6D5A556DD3D2D.title: "Skeleton Demoman"
	quest.9ABF12682BDB7BDA.quest_desc: ["Cut tall grass with a knife."]
	quest.9ABF12682BDB7BDA.title: "Straw"
	quest.9BE59DC6B19706C5.quest_desc: ["A copper backtank and helmet hold your breath underwater."]
	quest.9BE59DC6B19706C5.title: "Diving Gear"
	quest.9D886E01C48B1318.quest_desc: ["The warmest drink there is. Take some north."]
	quest.9D886E01C48B1318.title: "Hot Cocoa"
	quest.9EA7A6A20FFADAD8.quest_desc: ["A box you carry around. The flight north gets easier."]
	quest.9EA7A6A20FFADAD8.title: "Shulker Box"
	quest.9EC8A39A8FFEF516.quest_desc: ["Faster still."]
	quest.9EC8A39A8FFEF516.title: "Diamond Brush"
	quest.9FBB5CFB93AA3119.quest_desc: ["Collect it in bottles."]
	quest.9FBB5CFB93AA3119.title: "Dragon's Breath"
	quest.A0A1040529E200F6.quest_desc: ["The archeologists' temple in the southern jungle."]
	quest.A0A1040529E200F6.title: "Lost Temple"
	quest.A0B1FA5A024DD50C.quest_desc: ["Create Additions turns electricity into rotation."]
	quest.A0B1FA5A024DD50C.title: "Electric Motor"
	quest.A0F83F209478D8DF.quest_desc: ["A steam engine on a fluid tank with a burner."]
	quest.A0F83F209478D8DF.title: "Steam"
	quest.A1E2F25A0165C779.quest_desc: ["Cold Sweat tracks your body temperature. A thermometer shows how warm it is around you."]
	quest.A1E2F25A0165C779.title: "Thermometer"
	quest.A2A6BF64C165711A.quest_desc: ["Better Combat changes how fights feel: weapons hit in combos, each with its own reach. The Dark Warblade is a two-handed claymore now, the Great Reaper Axe a two-handed axe, the Skullbreaker a two-handed hammer and the pitchfork a spear. Chaos staffs still work on right-click."]
	quest.A2A6BF64C165711A.title: "New Combat"
	quest.A2F60D1C29A9AEB9.quest_desc: ["Offroad adds wheels. A ship can drive on land as well."]
	quest.A2F60D1C29A9AEB9.title: "Rover"
	quest.A4C762C823CD57D6.quest_desc: ["Shoots food. Better than it sounds."]
	quest.A4C762C823CD57D6.title: "Potato Cannon"
	quest.A53F64A34921796E.quest_desc: ["A nether star and obsidian."]
	quest.A53F64A34921796E.title: "Beacon"
	quest.A5EF27E3BF9A238A.quest_desc: ["Walk to the grey shore. Go no further: the fog is poison."]
	quest.A5EF27E3BF9A238A.title: "Edge of the World"
	quest.A6B24DBE2B9ECE71.quest_desc: ["Diesel Generators' strongest engine."]
	quest.A6B24DBE2B9ECE71.title: "Huge Diesel Engine"
	quest.A6B3E224BE0B43A2.quest_desc: ["Cabbages grow by the shore, onions on the plains. Gather both."]
	quest.A6B3E224BE0B43A2.title: "Wild Vegetables"
	quest.A7B4FD4982C710F5.quest_desc: ["Craft a crafting table."]
	quest.A7B4FD4982C710F5.title: "First Planks"
	quest.A856DFEB22633543.quest_desc: ["And back: power into rotation."]
	quest.A856DFEB22633543.title: "New Age Motor"
	quest.A8D9ED4CB99978FF.quest_desc: ["Lifesteal and wither."]
	quest.A8D9ED4CB99978FF.title: "Nightmare Scythe"
	quest.AB65C5715EF15246.quest_desc: ["A hoe and some wheat. Food is scarce on the islands."]
	quest.AB65C5715EF15246.title: "Farm"
	quest.ABC6EC38598954EB.quest_desc: ["Careful, you'll want it for a reactor."]
	quest.ABC6EC38598954EB.title: "Uranium"
	quest.AC365A657D57407F.quest_desc: ["Drills ore nodes forever."]
	quest.AC365A657D57407F.title: "Deep Drill"
	quest.AD9C6B5CDD4A72BE.quest_desc: ["Summon and defeat the Wither. Far from home."]
	quest.AD9C6B5CDD4A72BE.title: "The Wither"
	quest.B0036867805EA6D5.quest_desc: ["Break a loot vase."]
	quest.B0036867805EA6D5.title: "Vase"
	quest.B1AFBE8CAAB3188F.quest_desc: ["A balloon's envelope is sewn from wool and sticks."]
	quest.B1AFBE8CAAB3188F.title: "Envelope"
	quest.B27FB98BDF2373BA.quest_desc: ["A mixer over a basin mixes what you can't craft by hand."]
	quest.B27FB98BDF2373BA.title: "Mixer"
	quest.B2F1403AB0B6753D.quest_desc: ["Mined blocks drop already smelted. Here's a book."]
	quest.B2F1403AB0B6753D.title: "Smelting"
	quest.B3ED485838982C35.quest_desc: ["Iron charged in the energiser."]
	quest.B3ED485838982C35.title: "Overcharged Iron"
	quest.B4121C8FCBEF4EC1.title: "Scarlet Persecutor"
	quest.B467FCEF22AFFB9C.quest_desc: ["Huddle up to a friend or a pet to keep warm."]
	quest.B467FCEF22AFFB9C.title: "Huddle Close"
	quest.B4EDD3D4B260DC0A.quest_desc: ["An ancient enchantment for elytra. Earn it by flying north."]
	quest.B4EDD3D4B260DC0A.title: "Soaring Winds"
	quest.B69E05F385946290.quest_desc: ["A windmill bearing and sails turn without water."]
	quest.B69E05F385946290.title: "Windmill"
	quest.B8424CBA31AEF41A.quest_desc: ["Dig up any fossil."]
	quest.B8424CBA31AEF41A.title: "Fossil"
	quest.B941662BD692035B.quest_desc: ["Heat into rotation."]
	quest.B941662BD692035B.title: "Stirling Engine"
	quest.B9D24F2994467FEB.quest_desc: ["They hunt in packs."]
	quest.B9D24F2994467FEB.title: "Dread Hounds"
	quest.BB0147D256A72E76.quest_desc: ["A knife cuts grass into straw and meat into cuts. The kitchen starts here. AppleSkin shows how filling each dish is."]
	quest.BB0147D256A72E76.title: "Knife"
	quest.BB1137C51525EBB2.quest_desc: ["A full set of goat fur armour."]
	quest.BB1137C51525EBB2.title: "Full Fur"
	quest.BC624DE76152228A.quest_desc: ["Someone was digging here before you."]
	quest.BC624DE76152228A.title: "Archeologists' Camp"
	quest.BDC87E3032B044AB.quest_desc: ["Fuel made of thorium."]
	quest.BDC87E3032B044AB.title: "Nuclear Fuel"
	quest.BE7BA3D77DAA1ED3.quest_desc: ["A full set of dark metal. In this pack it gives Strength I."]
	quest.BE7BA3D77DAA1ED3.title: "Chaos Knight"
	quest.BE9A70573691E0A3.quest_desc: ["A pickaxe digs several blocks at once. Earn the book by digging deepslate."]
	quest.BE9A70573691E0A3.title: "Tunneling"
	quest.BF0DD4D605F5FA46.quest_desc: ["Heat the blend and it crystallises. Levitite holds a ship up, but can't lift it on its own."]
	quest.BF0DD4D605F5FA46.title: "Levitite"
	quest.BF3D3BFEDA85A930.quest_desc: ["The eldest of the bonescallers."]
	quest.BF3D3BFEDA85A930.title: "Supreme Bonescaller"
	quest.BF3D52997756353E.quest_desc: ["His axe splits shields too."]
	quest.BF3D52997756353E.title: "Zombie Lumberjack"
	quest.BF4BF63D52649624.quest_desc: ["Funnels take items from chests and put them on belts."]
	quest.BF4BF63D52649624.title: "Funnels"
	quest.BF93180CA875881A.quest_desc: ["Diesel gives rotation without water or wind."]
	quest.BF93180CA875881A.title: "Diesel Engine"
	quest.C03B1C7C6E38BC53.quest_desc: ["Dough, tomato sauce and minced beef."]
	quest.C03B1C7C6E38BC53.title: "Pasta with Meatballs"
	quest.C1A3A86D29FCD841.quest_desc: ["A semaphore shows whether the line is clear."]
	quest.C1A3A86D29FCD841.title: "Semaphore"
	quest.C30EEFC8CC04719E.quest_desc: ["You can't craft a diamond pickaxe yet: Pale Store unlocks its recipe once you reach the Nether. The diamonds will still come in handy."]
	quest.C30EEFC8CC04719E.title: "Diamonds"
	quest.C46F1EF791847FB7.quest_desc: ["Hardly anything attacks you here."]
	quest.C46F1EF791847FB7.title: "Warped Forest"
	quest.C48A5C767908D1E4.quest_desc: ["The fermenter makes fuel from plants. It's the backup plan without oil."]
	quest.C48A5C767908D1E4.title: "Plant Oil"
	quest.C7932ED33706A4C0.quest_desc: ["Hoglins graze in the crimson forest."]
	quest.C7932ED33706A4C0.title: "Crimson Forest"
	quest.C8D47269F11D1242.quest_desc: ["An old fort on a mound in the woods."]
	quest.C8D47269F11D1242.title: "Motte"
	quest.C8F69B71BADEC961.quest_desc: ["Crushing wheels turn end stone into powder. Levitite for airships is made from it."]
	quest.C8F69B71BADEC961.title: "End Stone Powder"
	quest.C988A9961035406B.quest_desc: ["Enter the End portal."]
	quest.C988A9961035406B.title: "The End?"
	quest.C98A2D2CD3B01050.quest_desc: ["Put the pot on the stove. Soups and stews cook in it."]
	quest.C98A2D2CD3B01050.title: "Cooking Pot"
	quest.C99AB36B29666371.quest_desc: ["Pour the elixir on an infernal pumpkin and defeat the Lord."]
	quest.C99AB36B29666371.title: "Lord Pumpkinhead"
	quest.C9A60CFC6CC71D67.quest_desc: ["Charges iron and gold with power."]
	quest.C9A60CFC6CC71D67.title: "Energiser"
	quest.C9CD56A57D4E55A4.quest_desc: ["Pours fluids into bottles and onto parts."]
	quest.C9CD56A57D4E55A4.title: "Spout"
	quest.CA556D7CD9BDBF91.quest_desc: ["Symmetric sails catch the wind."]
	quest.CA556D7CD9BDBF91.title: "Sails"
	quest.CAD349C8E447E551.quest_desc: ["Blue fire and soul sand."]
	quest.CAD349C8E447E551.title: "Soul Sand Valley"
	quest.CB03880F1C26F0ED.quest_desc: ["A mechanical press turns ingots into sheets."]
	quest.CB03880F1C26F0ED.title: "Press"
	quest.CB0F891B4036C99F.quest_desc: ["Two skulls, one spine."]
	quest.CB0F891B4036C99F.title: "Siamese Skeletons"
	quest.CC8251E4D1C6AA30.quest_desc: ["A controller on a column of fluid tanks splits oil into fractions."]
	quest.CC8251E4D1C6AA30.title: "Distillation"
	quest.CCBE9AD642E91296.quest_desc: ["Nasty things in the water."]
	quest.CCBE9AD642E91296.title: "Carrion Fish"
	quest.CDAA5FFB4B8FBD43.quest_desc: ["Lives by the water."]
	quest.CDAA5FFB4B8FBD43.title: "Zombie Fisherman"
	quest.CDF3B18A3D57CD81.quest_desc: ["Find a dark forest. That's where mansions stand."]
	quest.CDF3B18A3D57CD81.title: "Dark Forest"
	quest.CE4C20E946F41672.quest_desc: ["The heart of Create's advanced machines."]
	quest.CE4C20E946F41672.title: "Precision Mechanism"
	quest.CE4E427D54CEA209.quest_desc: ["What's left from distillation becomes asphalt. You run faster on it."]
	quest.CE4E427D54CEA209.title: "Asphalt"
	quest.CF2C221048E9A69F.quest_desc: ["Hits hard."]
	quest.CF2C221048E9A69F.title: "Zombie Bruiser"
	quest.D0B8518015D93474.quest_desc: ["Shulker shells for boxes."]
	quest.D0B8518015D93474.title: "Shulkers"
	quest.D2C48897B0391DA4.quest_desc: ["Permafrost shards. The Frostbitten Blade is forged from them."]
	quest.D2C48897B0391DA4.title: "Permafrost"
	quest.D4320B3D256A2A18.quest_desc: ["A jumping blow stuns."]
	quest.D4320B3D256A2A18.title: "Skullbreaker Hammer"
	quest.D58294EEFE87A521.quest_desc: ["Lifts cargo on a rope."]
	quest.D58294EEFE87A521.title: "Rope Winch"
	quest.D5876116D09A4A94.quest_desc: ["Elytra go into their own slot (Elytra Slot), so your chestplate stays on. Fly north in a fur-lined chestplate."]
	quest.D5876116D09A4A94.title: "Wing Slot"
	quest.D67EFDB2909E622E.quest_desc: ["Create needs copper, and so does a waterskin."]
	quest.D67EFDB2909E622E.title: "Copper"
	quest.D7663AC209CBDFA4.quest_desc: ["Every kill stokes your Rampage."]
	quest.D7663AC209CBDFA4.title: "Great Reaper Axe"
	quest.D88E282B1E8AB802.quest_desc: ["A pump and pipes move water, lava and anything that flows."]
	quest.D88E282B1E8AB802.title: "Pump"
	quest.D8A86AB5D40AE123.quest_desc: ["Your first Oritech generator."]
	quest.D8A86AB5D40AE123.title: "Oritech"
	quest.D98E9E19AB6E1041.quest_desc: ["Find a swamp. Wild rice grows there, and witches live there."]
	quest.D98E9E19AB6E1041.title: "Swamp"
	quest.D9E931CC418BB150.quest_desc: ["Wash gravel: it yields nuggets."]
	quest.D9E931CC418BB150.title: "Washing"
	quest.DBF65E1459529D27.title: "Decaying Zombie"
	quest.DC7BBA04424DE05D.quest_desc: ["Oritech's big solar panel."]
	quest.DC7BBA04424DE05D.title: "Solar Panel"
	quest.DDBB3C9CFBE1A7F0.quest_desc: ["A mechanical hand that clicks for you."]
	quest.DDBB3C9CFBE1A7F0.title: "Deployer"
	quest.DE17EC8E24A4E902.quest_desc: ["Find a pillager outpost. They keep their distance from villages."]
	quest.DE17EC8E24A4E902.title: "Pillager Outpost"
	quest.DE1F5A5408C7DBDF.quest_desc: ["Crafts big recipes on its own."]
	quest.DE1F5A5408C7DBDF.title: "Mechanical Crafter"
	quest.DE60743011A9253E.quest_desc: ["The obelisk stands in the desert of the hot island."]
	quest.DE60743011A9253E.title: "Desert Obelisk"
	quest.DFC8884BF979CF66.quest_desc: ["A mechanical drill and saw dig and chop on their own."]
	quest.DFC8884BF979CF66.title: "Automation"
	quest.E14CFE4398E3FC6C.quest_desc: ["Defeat the Lifestealer."]
	quest.E14CFE4398E3FC6C.title: "Lifestealer"
	quest.E257C11FF030B148.quest_desc: ["Beef stew is more filling and warms you too."]
	quest.E257C11FF030B148.title: "Stew"
	quest.E2BF3F56EC398E2B.quest_desc: ["Climb above 500 blocks: no fog and no poison up there. Below lies a sea of clouds with the islands as holes in it."]
	quest.E2BF3F56EC398E2B.title: "Above the Clouds"
	quest.E30FD8AB50DCEDE6.quest_desc: ["Find the trial chambers underground and get a trial key."]
	quest.E30FD8AB50DCEDE6.title: "Trial Chambers"
	quest.E35516F1AD254645.quest_desc: ["Artifacts are identified on it."]
	quest.E35516F1AD254645.title: "Archeology Table"
	quest.E41005752AAF6989.quest_desc: ["Run a propeller on a ship."]
	quest.E41005752AAF6989.title: "Thrust"
	quest.E53992FFD62EEE01.quest_desc: ["All three strongholds are on the hot island, half way out from its centre."]
	quest.E53992FFD62EEE01.title: "Stronghold"
	quest.E541143ABF1D324D.quest_desc: ["Land ends about 1250 blocks from the centre. Beyond it lies a grey, poisonous sea behind a wall of fog. Two more islands wait somewhere past it."]
	quest.E541143ABF1D324D.title: "Welcome to the Pale"
	quest.E62C24D6541B96D3.quest_desc: ["A drill for an underground machine."]
	quest.E62C24D6541B96D3.title: "Borehead"
	quest.E6BB1CC21F626DDD.quest_desc: ["Straw is woven into canvas."]
	quest.E6BB1CC21F626DDD.title: "Canvas"
	quest.E6FBABA20A32879D.quest_desc: ["A well full of fire."]
	quest.E6FBABA20A32879D.title: "Firewell"
	quest.E8057D6B78C4CC00.quest_desc: ["The blow goes through armour. Earn the book by beating a ravager from a raid."]
	quest.E8057D6B78C4CC00.title: "Penetrating Strike"
	quest.E9AD1F3470900340.quest_desc: ["It shows height and air pressure. Pressure drops with height, and so does thrust."]
	quest.E9AD1F3470900340.title: "Altitude Sensor"
	quest.E9D79ACF1091D28A.quest_desc: ["Slay the Ender Dragon."]
	quest.E9D79ACF1091D28A.title: "The Dragon"
	quest.EADA0FE986A758A0.quest_desc: ["Enchant any item."]
	quest.EADA0FE986A758A0.title: "First Enchantment"
	quest.EB453C03F34C6392.quest_desc: ["Oritech's foundry makes steel."]
	quest.EB453C03F34C6392.title: "Steel"
	quest.EBBFE927BFD7CC3F.quest_desc: ["The scanner shows how much oil lies under a chunk. Search the desert, badlands and savanna: there is none on the other islands."]
	quest.EBBFE927BFD7CC3F.title: "Prospecting"
	quest.EC204740A618AA15.quest_desc: ["Take a ship as high as it goes. Around height 300 there's no air left, and the ship stops. Above 450, where the poison ends, nobody can stand on a deck: the Pale only lets go of those on wings."]
	quest.EC204740A618AA15.title: "The Pale's Ceiling"
	quest.EC7E43831A5017C0.quest_desc: ["A stressometer shows how much more load your network can take."]
	quest.EC7E43831A5017C0.title: "Stress"
	quest.ECA11DA32F4F7DDE.quest_desc: ["Find a Nether fortress."]
	quest.ECA11DA32F4F7DDE.title: "Fortress"
	quest.EDD0B934A341F1F9.quest_desc: ["Wild rice grows in swamps and jungles. Plant it in water."]
	quest.EDD0B934A341F1F9.title: "Rice"
	quest.EE36748374FCDE66.quest_desc: ["Wild tomatoes only grow where it's hot. That means the hot island."]
	quest.EE36748374FCDE66.title: "Tomatoes"
	quest.EE4CB3B7BB11E21C.quest_desc: ["Step out of the portal and find the desert. Drink water and watch your thermometer."]
	quest.EE4CB3B7BB11E21C.title: "Southern Sands"
	quest.EE686D1726C68213.quest_desc: ["A big store made of iron sheets."]
	quest.EE686D1726C68213.title: "Item Vault"
	quest.EF5337DC970DB68C.quest_desc: ["Fight off a raid on a village."]
	quest.EF5337DC970DB68C.title: "Raid"
	quest.F1B68E3780D7E7E9.quest_desc: ["Find a stone circle on the plains."]
	quest.F1B68E3780D7E7E9.title: "Stone Circle"
	quest.F1D741031868AB0C.quest_desc: ["Evil pumpkins grow here."]
	quest.F1D741031868AB0C.title: "Cursed Farm"
	quest.F24365EB011E31E6.quest_desc: ["Find a witch hut in the swamp."]
	quest.F24365EB011E31E6.title: "Witch Hut"
	quest.F2F4E7B325137CB1.quest_desc: ["A steering wheel and a throttle lever."]
	quest.F2F4E7B325137CB1.title: "Steering"
	quest.F2F9FEBA0B99A12B.quest_desc: ["Deep in the Nether."]
	quest.F2F9FEBA0B99A12B.title: "Ancient Debris"
	quest.F33D147DABDE9D02.quest_desc: ["A jetpack with elytra makes flying between islands easier."]
	quest.F33D147DABDE9D02.title: "Jetpack"
	quest.F3CB050C8F07B87F.quest_desc: ["The hounds' lair."]
	quest.F3CB050C8F07B87F.title: "Mound of Hounds"
	quest.F4270BCBAB292772.quest_desc: ["Dig up a cursed grave."]
	quest.F4270BCBAB292772.title: "Graves"
	quest.F519FB621D212C41.quest_desc: ["The upgrade template lies in a bastion."]
	quest.F519FB621D212C41.title: "Smithing Upgrade"
	quest.F697D66FB4E0E128.quest_desc: ["A stove heats whatever stands on it."]
	quest.F697D66FB4E0E128.title: "Stove"
	quest.F7BCEC682CE4FE4C.quest_desc: ["Another fraction."]
	quest.F7BCEC682CE4FE4C.title: "Gasoline"
	quest.F9BC6FA18749A3B5.quest_desc: ["For better wires and magnets."]
	quest.F9BC6FA18749A3B5.title: "Overcharged Gold"
	quest.FA2BCD9950313F2F.quest_desc: ["Find a desert pyramid. Mind the floor."]
	quest.FA2BCD9950313F2F.title: "Pyramid"
	quest.FB503FD5B2AE693A.quest_desc: ["There were none on the starter island. Here there are."]
	quest.FB503FD5B2AE693A.title: "Spawn of Chaos"
	quest.FBBFEBF366BDE7D3.quest_desc: ["Pipes for items and energy."]
	quest.FBBFEBF366BDE7D3.title: "Oritech Pipes"
	quest.FD7FFD8C48C4CE4C.quest_desc: ["Put an unidentified artifact on the archeology table. It turns into a book with one of three ancient enchantments: Soaring Winds, Penetrating Strike or Tunneling."]
	quest.FD7FFD8C48C4CE4C.title: "Identify an Artifact"
	quest.FE48AF787B5579EB.quest_desc: ["It points to where you last died. With the Corpse mod that's the way back to your things. Echo shards come only from ancient cities."]
	quest.FE48AF787B5579EB.title: "Recovery Compass"
	quest.FE9F3C3908AE7FEE.quest_desc: ["It eats diamond ore."]
	quest.FE9F3C3908AE7FEE.title: "Diamond Termite"
}
