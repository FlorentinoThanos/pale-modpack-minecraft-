{
	chapter.52326DE657CCE52E.chapter_subtitle: ["Главный путь: от первого верстака до перехода на горячий остров."]
	chapter.52326DE657CCE52E.title: "Тихий остров"
	chapter_group.EFA7D509EB9A847A.title: "The Pale"
	quest.06F27455A8C1762B.quest_desc: ["Сделай ведро. В награду случайная книга «Озарение» I–III."]
	quest.06F27455A8C1762B.title: "Ведро"
	quest.11EE6307F604292F.quest_desc: ["Обсидиан без алмазной кирки не добыть, поэтому портал отливают на месте: выложи форму, залей лаву в каждую ячейку рамки и полей водой. Ещё обсидиан бывает в разрушенных порталах. Войди в Незер, и откроется рецепт алмазной кирки."]
	quest.11EE6307F604292F.title: "В Незер"
	quest.142A7D5B0E76BB45.quest_desc: ["Размножь любых животных."]
	quest.142A7D5B0E76BB45.title: "Пополнение"
	quest.18BAE9E1D07C3F7C.quest_desc: ["Сделай каменную кирку. В награду откроется рецепт кровати: до этого его нет."]
	quest.18BAE9E1D07C3F7C.title: "Каменный век"
	quest.238CF919ACEEAA52.quest_desc: ["Когда вокруг слишком холодно (ночью или высоко в горах), согрейся у тёплого блока, например у костра."]
	quest.238CF919ACEEAA52.title: "Поближе к огню"
	quest.2B84337841810FE1.quest_desc: ["Поставь дымоход на бойлер или ледник."]
	quest.2B84337841810FE1.title: "Уютно"
	quest.32B2FC7FC1FE0154.quest_desc: ["Сделай кровать любого цвета. Теперь ночь можно проспать."]
	quest.32B2FC7FC1FE0154.title: "Своя кровать"
	quest.3C8B601B55377999.quest_desc: ["Спустись в любой пещерный биом."]
	quest.3C8B601B55377999.title: "Под землёй"
	quest.46CDA9D5A810A1B4.quest_desc: ["Сложи костёр и пожарь на нём мясо. Дальше кухня: глава Farmer's Delight."]
	quest.46CDA9D5A810A1B4.title: "Ужин у костра"
	quest.63B83E7FF2A56CF8.quest_desc: ["Железная кирка добывает алмазы. Огнестойкость в награду пригодится у лавы."]
	quest.63B83E7FF2A56CF8.title: "Железная кирка"
	quest.8D317297C92105F5.quest_desc: ["Зачаруй предметы на столе 30 раз. Дальше глава Death List."]
	quest.8D317297C92105F5.title: "Чародей"
	quest.958DB0DBDAB97DEE.quest_desc: ["Утепли любую часть брони на швейном столе."]
	quest.958DB0DBDAB97DEE.title: "Подкладка"
	quest.A7B4FD4982C710F5.quest_desc: ["Сделай верстак."]
	quest.A7B4FD4982C710F5.title: "Верстак"
	quest.B47ECC69BCE02B07.quest_desc: ["Сделай железные поножи и ботинки."]
	quest.B47ECC69BCE02B07.title: "Ноги в железе"
	quest.B739C0C06C989C7E.quest_desc: ["Сделай стол зачарований."]
	quest.B739C0C06C989C7E.title: "Стол зачарований"
	quest.C30EEFC8CC04719E.quest_desc: ["Добудь 5 алмазов. Алмазную кирку пока не скрафтить: её рецепт откроется в Незере."]
	quest.C30EEFC8CC04719E.title: "Алмазы"
	quest.C3D38460798BDC87.quest_desc: ["Посади любую культуру."]
	quest.C3D38460798BDC87.title: "Первый урожай"
	quest.C7F23E6BC846E84A.quest_desc: ["Отрази стрелу щитом."]
	quest.C7F23E6BC846E84A.title: "Не сегодня"
	quest.CFEBB1AD4B9148A2.quest_desc: ["Сделай факелы. В награду откроется рецепт лестниц."]
	quest.CFEBB1AD4B9148A2.title: "Факелы"
	quest.D2D4A2355D369CE6.quest_desc: ["Пещеры пройдены, железо надето. Возьми огнестойкость подольше."]
	quest.D2D4A2355D369CE6.title: "Готов к жаре"
	quest.DF7D080C32D1BF06.quest_desc: ["Добудь уголь."]
	quest.DF7D080C32D1BF06.title: "Уголь"
	quest.E541143ABF1D324D.quest_desc: ["Земля кончается примерно в 1250 блоках отсюда. Дальше серое ядовитое море и стена тумана. Где-то за ним есть ещё два острова. Начни с малого."]
	quest.E541143ABF1D324D.title: "Серый горизонт"
	quest.E55E5A51D507619D.quest_desc: ["Принеси 15 книжных полок (они не заберутся) и поставь их вокруг стола: так он даёт самые сильные зачарования."]
	quest.E55E5A51D507619D.title: "Полная мощность"
	quest.F99E7F1C5D6A46BF.quest_desc: ["Горячий остров лежит в 3500–4500 блоках к югу, в Незере это в 8 раз ближе. Иди на юг до места около x 0, z 500 (от −60 до 60 по x и от 440 до 560 по z). Портал, построенный там, выведет на горячий остров."]
	quest.F99E7F1C5D6A46BF.title: "Дорога на юг"
	reward_table.412962825CC1473A.title: "Книга «Озарение»"
	reward_table.8E28176B09638154.title: "Железный инструмент"
	reward_table.A3C91D56D4883B5C.title: "Книга «Эффективность»"
	reward_table.D2C654FC8A195807.title: "Книга «Защита»"
}
