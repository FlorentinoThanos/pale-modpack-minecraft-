	quest.AC365A657D57407F.quest_desc: ["Бурит рудные жилы бесконечно."]
	quest.AC365A657D57407F.title: "Глубинный бур"
	quest.AD9C6B5CDD4A72BE.quest_desc: ["Призови и победи Иссушителя. Подальше от дома."]
	quest.AD9C6B5CDD4A72BE.title: "Иссушитель"
	quest.B0036867805EA6D5.quest_desc: ["Разбей вазу с добычей."]
	quest.B0036867805EA6D5.title: "Ваза"
	quest.B1AFBE8CAAB3188F.quest_desc: ["Оболочку шара шьют из шерсти и палок."]
	quest.B1AFBE8CAAB3188F.title: "Оболочка"
	quest.B27FB98BDF2373BA.quest_desc: ["Миксер с чашей смешивает то, что нельзя скрафтить руками."]
	quest.B27FB98BDF2373BA.title: "Миксер"
	quest.B2F1403AB0B6753D.quest_desc: ["Добытые блоки сразу выпадают переплавленными. Держи книгу."]
	quest.B2F1403AB0B6753D.title: "Переплавка"
	quest.B3ED485838982C35.quest_desc: ["Железо, заряженное в энергайзере."]
	quest.B3ED485838982C35.title: "Заряженное железо"
	quest.B4121C8FCBEF4EC1.title: "Алый преследователь"
	quest.B467FCEF22AFFB9C.quest_desc: ["Прижмись к другу или к питомцу, чтобы согреться."]
	quest.B467FCEF22AFFB9C.title: "Погреться вместе"
	quest.B4EDD3D4B260DC0A.quest_desc: ["Древнее зачарование для элитр. Заслужи его перелётом на север."]
	quest.B4EDD3D4B260DC0A.title: "Парящий ветер"
	quest.B69E05F385946290.quest_desc: ["Подшипник ветряка и паруса вращают без воды."]
	quest.B69E05F385946290.title: "Ветряк"
	quest.B8424CBA31AEF41A.quest_desc: ["Раскопай любую окаменелость."]
	quest.B8424CBA31AEF41A.title: "Окаменелость"
	quest.B941662BD692035B.quest_desc: ["Тепло во вращение."]
	quest.B941662BD692035B.title: "Двигатель Стирлинга"
	quest.B9D24F2994467FEB.quest_desc: ["Охотятся стаей."]
	quest.B9D24F2994467FEB.title: "Ужасные гончие"
	quest.BB0147D256A72E76.quest_desc: ["Нож режет траву на солому, а мясо на куски. С ним начинается кухня. AppleSkin покажет, сколько сытости даёт каждое блюдо."]
	quest.BB0147D256A72E76.title: "Нож"
	quest.BB1137C51525EBB2.quest_desc: ["Полный комплект брони из козьего меха."]
	quest.BB1137C51525EBB2.title: "Полная шуба"
	quest.BC624DE76152228A.quest_desc: ["Кто-то копал здесь до тебя."]
	quest.BC624DE76152228A.title: "Лагерь археологов"
	quest.BDC87E3032B044AB.quest_desc: ["Топливо из тория."]
	quest.BDC87E3032B044AB.title: "Ядерное топливо"
	quest.BE7BA3D77DAA1ED3.quest_desc: ["Полный комплект тёмного металла. В этой сборке он даёт Силу I."]
	quest.BE7BA3D77DAA1ED3.title: "Рыцарь хаоса"
	quest.BE9A70573691E0A3.quest_desc: ["Кирка копает сразу несколько блоков. Заслужи книгу, накопав глубинного сланца."]
	quest.BE9A70573691E0A3.title: "Проходка"
	quest.BF0DD4D605F5FA46.quest_desc: ["Нагрей смесь, и она кристаллизуется. Левитит держит корабль в воздухе, но поднять его сам не может."]
	quest.BF0DD4D605F5FA46.title: "Левитит"
	quest.BF3D3BFEDA85A930.quest_desc: ["Старший из призывателей костей."]
	quest.BF3D3BFEDA85A930.title: "Верховный призыватель"
	quest.BF3D52997756353E.quest_desc: ["Его топор колет и щиты."]
	quest.BF3D52997756353E.title: "Зомби-лесоруб"
	quest.BF4BF63D52649624.quest_desc: ["Воронки берут и кладут предметы в сундуки и на ремень."]
	quest.BF4BF63D52649624.title: "Воронки"
	quest.BF93180CA875881A.quest_desc: ["Дизель даёт вращение без воды и ветра."]
	quest.BF93180CA875881A.title: "Дизельный двигатель"
	quest.C03B1C7C6E38BC53.quest_desc: ["Тесто, томатный соус и фарш."]
	quest.C03B1C7C6E38BC53.title: "Паста с фрикадельками"
	quest.C1A3A86D29FCD841.quest_desc: ["Семафор показывает, свободен ли путь."]
	quest.C1A3A86D29FCD841.title: "Семафор"
	quest.C30EEFC8CC04719E.quest_desc: ["Алмазную кирку пока не скрафтить: её рецепт в Pale Store откроется в Незере. А вот алмазы уже пригодятся."]
	quest.C30EEFC8CC04719E.title: "Алмазы"
	quest.C46F1EF791847FB7.quest_desc: ["Здесь почти не нападают."]
	quest.C46F1EF791847FB7.title: "Искажённый лес"
	quest.C48A5C767908D1E4.quest_desc: ["Ферментер делает биотопливо из растений. Это запасной путь без нефти."]
	quest.C48A5C767908D1E4.title: "Масло из семян"
	quest.C7932ED33706A4C0.quest_desc: ["Хоглины пасутся в багровом лесу."]
	quest.C7932ED33706A4C0.title: "Багровый лес"
	quest.C8D47269F11D1242.quest_desc: ["Старое укрепление на холме в лесу."]
	quest.C8D47269F11D1242.title: "Мотт"
	quest.C8F69B71BADEC961.quest_desc: ["Дробильные колёса превращают эндерняк в порошок. Из него делают левитит для кораблей."]
	quest.C8F69B71BADEC961.title: "Порошок эндерняка"
	quest.C988A9961035406B.quest_desc: ["Войди в портал Края."]
	quest.C988A9961035406B.title: "Конец?"
	quest.C98A2D2CD3B01050.quest_desc: ["Поставь котёл на плиту. В нём варят супы и рагу."]
	quest.C98A2D2CD3B01050.title: "Котёл"
	quest.C99AB36B29666371.quest_desc: ["Полей эликсиром адскую тыкву и победи Лорда."]
	quest.C99AB36B29666371.title: "Лорд Тыквоголовый"
	quest.C9A60CFC6CC71D67.quest_desc: ["Заряжает железо и золото током."]
	quest.C9A60CFC6CC71D67.title: "Энергайзер"
	quest.C9CD56A57D4E55A4.quest_desc: ["Разливает жидкость в бутылки и на детали."]
	quest.C9CD56A57D4E55A4.title: "Разливщик"
	quest.CA556D7CD9BDBF91.quest_desc: ["Симметричные паруса ловят ветер."]
	quest.CA556D7CD9BDBF91.title: "Паруса"
	quest.CAD349C8E447E551.quest_desc: ["Синий огонь и песок душ."]
	quest.CAD349C8E447E551.title: "Долина душ"
	quest.CB03880F1C26F0ED.quest_desc: ["Механический пресс делает листы из слитков."]
	quest.CB03880F1C26F0ED.title: "Пресс"
	quest.CB0F891B4036C99F.quest_desc: ["Два черепа, один хребет."]
	quest.CB0F891B4036C99F.title: "Сиамские скелеты"
	quest.CC8251E4D1C6AA30.quest_desc: ["Контроллер на колонне из резервуаров разгоняет нефть на фракции."]
	quest.CC8251E4D1C6AA30.title: "Перегонка"
	quest.CCBE9AD642E91296.quest_desc: ["Гадость из воды."]
	quest.CCBE9AD642E91296.title: "Рыбы-трупоеды"
	quest.CDAA5FFB4B8FBD43.quest_desc: ["Живёт у воды."]
	quest.CDAA5FFB4B8FBD43.title: "Зомби-рыбак"
	quest.CDF3B18A3D57CD81.quest_desc: ["Найди тёмный лес. Там стоят особняки."]
	quest.CDF3B18A3D57CD81.title: "Тёмный лес"
	quest.CE4C20E946F41672.quest_desc: ["Сердце сложных машин Create."]
	quest.CE4C20E946F41672.title: "Точный механизм"
	quest.CE4E427D54CEA209.quest_desc: ["Остатки перегонки идут на асфальт. По нему быстрее бегать."]
	quest.CE4E427D54CEA209.title: "Асфальт"
	quest.CF2C221048E9A69F.quest_desc: ["Бьёт больно."]
	quest.CF2C221048E9A69F.title: "Зомби-громила"
	quest.D0B8518015D93474.quest_desc: ["Панцири шалкеров для ящиков."]
	quest.D0B8518015D93474.title: "Шалкеры"
	quest.D2C48897B0391DA4.quest_desc: ["Осколки вечной мерзлоты. Из них куют Морозный клинок."]
	quest.D2C48897B0391DA4.title: "Вечная мерзлота"
	quest.D4320B3D256A2A18.quest_desc: ["Удар в прыжке оглушает."]
	quest.D4320B3D256A2A18.title: "Молот-черепокол"
	quest.D58294EEFE87A521.quest_desc: ["Поднимает груз на канате."]
	quest.D58294EEFE87A521.title: "Лебёдка"
	quest.D5876116D09A4A94.quest_desc: ["Элитры надеваются в отдельный слот (Elytra Slot), так что нагрудник остаётся на месте. На север лети в утеплённом нагруднике."]
	quest.D5876116D09A4A94.title: "Слот для крыльев"
	quest.D67EFDB2909E622E.quest_desc: ["Медь нужна и для Create, и для бурдюка."]
	quest.D67EFDB2909E622E.title: "Медь"
	quest.D7663AC209CBDFA4.quest_desc: ["Каждое убийство разгоняет Rampage."]
	quest.D7663AC209CBDFA4.title: "Секира жнеца"
	quest.D88E282B1E8AB802.quest_desc: ["Насос и трубы качают воду, лаву и всё, что течёт."]
	quest.D88E282B1E8AB802.title: "Насос"
	quest.D8A86AB5D40AE123.quest_desc: ["Первый генератор Oritech."]
	quest.D8A86AB5D40AE123.title: "Oritech"
	quest.D98E9E19AB6E1041.quest_desc: ["Найди болото. Там растёт дикий рис и живут ведьмы."]
	quest.D98E9E19AB6E1041.title: "Болото"
	quest.D9E931CC418BB150.quest_desc: ["Промой гравий: из него выпадают самородки."]
	quest.D9E931CC418BB150.title: "Промывка"
	quest.DBF65E1459529D27.title: "Гниющий зомби"
	quest.DC7BBA04424DE05D.quest_desc: ["Большая солнечная панель Oritech."]
	quest.DC7BBA04424DE05D.title: "Солнечная панель"
	quest.DDBB3C9CFBE1A7F0.quest_desc: ["Механическая рука, которая кликает за тебя."]
	quest.DDBB3C9CFBE1A7F0.title: "Установщик"
	quest.DE17EC8E24A4E902.quest_desc: ["Найди аванпост разбойников. Они стоят подальше от деревень."]
	quest.DE17EC8E24A4E902.title: "Аванпост"
	quest.DE1F5A5408C7DBDF.quest_desc: ["Крафтит большие рецепты сам."]
	quest.DE1F5A5408C7DBDF.title: "Механический крафтер"
	quest.DE60743011A9253E.quest_desc: ["Обелиск стоит в пустыне горячего острова."]
	quest.DE60743011A9253E.title: "Обелиск"
	quest.DFC8884BF979CF66.quest_desc: ["Механическая дрель и пила рубят и копают сами."]
	quest.DFC8884BF979CF66.title: "Автоматизация"
	quest.E14CFE4398E3FC6C.quest_desc: ["Победи Похитителя жизни."]
	quest.E14CFE4398E3FC6C.title: "Похититель жизни"
	quest.E257C11FF030B148.quest_desc: ["Говяжье рагу сытнее и тоже греет."]
	quest.E257C11FF030B148.title: "Рагу"
	quest.E2BF3F56EC398E2B.quest_desc: ["Поднимись выше 500 блоков: там нет ни тумана, ни яда. Внизу море облаков, острова видны как дыры в нём."]
	quest.E2BF3F56EC398E2B.title: "Над облаками"
	quest.E30FD8AB50DCEDE6.quest_desc: ["Найди испытательные палаты под землёй и добудь ключ испытаний."]
	quest.E30FD8AB50DCEDE6.title: "Испытания"
	quest.E35516F1AD254645.quest_desc: ["На нём опознают артефакты."]
	quest.E35516F1AD254645.title: "Стол археолога"
	quest.E41005752AAF6989.quest_desc: ["Запусти пропеллер на корабле."]
	quest.E41005752AAF6989.title: "Тяга"
	quest.E53992FFD62EEE01.quest_desc: ["Все три крепости стоят на горячем острове, на полпути от центра к берегу."]
	quest.E53992FFD62EEE01.title: "Крепость Края"
	quest.E541143ABF1D324D.quest_desc: ["Земля кончается примерно в 1250 блоках от центра. Дальше лежит серое ядовитое море и стена тумана. Где-то за ним есть ещё два острова."]
	quest.E541143ABF1D324D.title: "Добро пожаловать в Серость"
	quest.E62C24D6541B96D3.quest_desc: ["Бур для подземной машины."]
	quest.E62C24D6541B96D3.title: "Буровой подшипник"
	quest.E6BB1CC21F626DDD.quest_desc: ["Из соломы ткут холст."]
	quest.E6BB1CC21F626DDD.title: "Холст"
	quest.E6FBABA20A32879D.quest_desc: ["Колодец, полный огня."]
	quest.E6FBABA20A32879D.title: "Огненный колодец"
	quest.E8057D6B78C4CC00.quest_desc: ["Удар проходит сквозь броню. Заслужи книгу, победив разорителя из набега."]
	quest.E8057D6B78C4CC00.title: "Пробивающий удар"
	quest.E9AD1F3470900340.quest_desc: ["Показывает высоту и давление. Давление падает с высотой, и тяга вместе с ним."]
	quest.E9AD1F3470900340.title: "Датчик высоты"
	quest.E9D79ACF1091D28A.quest_desc: ["Убей Эндер-дракона."]
	quest.E9D79ACF1091D28A.title: "Дракон"
	quest.EADA0FE986A758A0.quest_desc: ["Зачаруй любой предмет."]
	quest.EADA0FE986A758A0.title: "Первые чары"
	quest.EB453C03F34C6392.quest_desc: ["Литейная Oritech делает сталь."]
	quest.EB453C03F34C6392.title: "Сталь"
	quest.EBBFE927BFD7CC3F.quest_desc: ["Сканер показывает, сколько нефти под чанком. Ищи в пустыне, пустошах и саванне: на других островах её нет."]
	quest.EBBFE927BFD7CC3F.title: "Нефтеразведка"
	quest.EC204740A618AA15.quest_desc: ["Поднимись на корабле как можно выше. Около высоты 300 воздуха уже нет, и корабль дальше не идёт. А выше 450, где нет яда, стоять на палубе нельзя: Бледнота отпускает только тех, кто летит на крыльях."]
	quest.EC204740A618AA15.title: "Потолок Бледноты"
	quest.EC7E43831A5017C0.quest_desc: ["Измеритель нагрузки показывает, сколько сети ещё можно нагрузить."]
	quest.EC7E43831A5017C0.title: "Нагрузка"
	quest.ECA11DA32F4F7DDE.quest_desc: ["Найди крепость Незера."]
	quest.ECA11DA32F4F7DDE.title: "Крепость"
	quest.EDD0B934A341F1F9.quest_desc: ["Дикий рис растёт в болотах и джунглях. Его сажают в воду."]
	quest.EDD0B934A341F1F9.title: "Рис"
	quest.EE36748374FCDE66.quest_desc: ["Дикие помидоры растут только в жарких краях. Это горячий остров."]
	quest.EE36748374FCDE66.title: "Помидоры"
	quest.EE4CB3B7BB11E21C.quest_desc: ["Выйди из портала и найди пустыню. Пей воду и следи за градусником."]
	quest.EE4CB3B7BB11E21C.title: "Пески юга"
	quest.EE686D1726C68213.quest_desc: ["Большой склад из железных листов."]
	quest.EE686D1726C68213.title: "Хранилище"
	quest.EF5337DC970DB68C.quest_desc: ["Отбей набег на деревню."]
	quest.EF5337DC970DB68C.title: "Набег"
	quest.F1B68E3780D7E7E9.quest_desc: ["Найди каменный круг на равнинах."]
	quest.F1B68E3780D7E7E9.title: "Каменный круг"
	quest.F1D741031868AB0C.quest_desc: ["Здесь растут злые тыквы."]
	quest.F1D741031868AB0C.title: "Проклятая ферма"
	quest.F24365EB011E31E6.quest_desc: ["Найди хижину ведьмы на болоте."]
	quest.F24365EB011E31E6.title: "Хижина ведьмы"
	quest.F2F4E7B325137CB1.quest_desc: ["Штурвал и рычаг тяги."]
	quest.F2F4E7B325137CB1.title: "Штурвал"
	quest.F2F9FEBA0B99A12B.quest_desc: ["Глубоко в Незере."]
	quest.F2F9FEBA0B99A12B.title: "Древние обломки"
	quest.F33D147DABDE9D02.quest_desc: ["Ранец с элитрами: летать между островами станет проще."]
	quest.F33D147DABDE9D02.title: "Реактивный ранец"
	quest.F3CB050C8F07B87F.quest_desc: ["Логово гончих."]
	quest.F3CB050C8F07B87F.title: "Курган гончих"
	quest.F4270BCBAB292772.quest_desc: ["Разрой проклятую могилу."]
	quest.F4270BCBAB292772.title: "Могилы"
	quest.F519FB621D212C41.quest_desc: ["Шаблон улучшения лежит в бастионе."]
	quest.F519FB621D212C41.title: "Улучшение"
	quest.F697D66FB4E0E128.quest_desc: ["Плита греет всё, что стоит на ней."]
	quest.F697D66FB4E0E128.title: "Плита"
	quest.F7BCEC682CE4FE4C.quest_desc: ["Ещё одна фракция."]
	quest.F7BCEC682CE4FE4C.title: "Бензин"
	quest.F9BC6FA18749A3B5.quest_desc: ["Для проводов и магнитов получше."]
	quest.F9BC6FA18749A3B5.title: "Заряженное золото"
	quest.FA2BCD9950313F2F.quest_desc: ["Найди пустынную пирамиду. Осторожно с полом."]
	quest.FA2BCD9950313F2F.title: "Пирамида"
	quest.FB503FD5B2AE693A.quest_desc: ["На стартовом острове их не было. Здесь они есть."]
	quest.FB503FD5B2AE693A.title: "Порождения хаоса"
	quest.FBBFEBF366BDE7D3.quest_desc: ["Трубы для предметов и энергии."]
	quest.FBBFEBF366BDE7D3.title: "Трубы Oritech"
	quest.FD7FFD8C48C4CE4C.quest_desc: ["Положи неопознанный артефакт на стол археолога. Он превратится в книгу с одним из трёх древних зачарований: Парящий ветер, Пробивающий удар или Проходка."]
	quest.FD7FFD8C48C4CE4C.title: "Опознать артефакт"
	quest.FE48AF787B5579EB.quest_desc: ["Он показывает, где ты умер в последний раз. С модом Corpse это дорога к твоим вещам. Осколки эха есть только в древних городах."]
	quest.FE48AF787B5579EB.title: "Компас восстановления"
	quest.FE9F3C3908AE7FEE.quest_desc: ["Он ест алмазную руду."]
	quest.FE9F3C3908AE7FEE.title: "Алмазный термит"
}
